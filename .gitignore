# 字节编译与原生编译产物：由源码随时重建，入库只会带来噪声与冲突。
*.elc
eln-cache/
.eln-cache/

# straight.el 的本地克隆 / 构建目录：本地环境私有，不应进版本库。
.local/

# autoloads 生成物：按需重建，且必然与源文件漂移（不入库）。
# 第二行是 ERT autoload 用例写到仓库根的输出（`eimg-autoloads-test-<pid>.el'）：
# 正常跑完即删，Ctrl-C 打断会残留，且名字与上一条规则不匹配。
*-autoloads.el
*-autoloads-test*.el

# Python 相关：OCR 后端脚本的缓存与虚拟环境。
__pycache__/
*.pyc
.venv/

# 测试临时目录：`make test' 把 TMPDIR 钉在这里（见 Makefile 的 TEST_TMPDIR），
# 保证 `make-temp-file' 的产物不会漂到用户自己的仓库里。正常跑完即删，不入库。
.tmp-test/

# 编辑器与系统杂项。
.dir-locals-2.el
*~
.DS_Store
