#!/usr/bin/env python3
"""eimg-ocr —— eimg 统一 OCR CLI（rapidocr / ollama / tesseract 识别 + PDF 分页已接入）。

当前能力：参数解析、退出码框架、后端探测、输入校验、输出序列化、
**图片经 rapidocr、tesseract 或 ollama 视觉模型识别**、**PDF 经 pdftoppm 栅格化后
按页识别**（`--pdf-pages` 选中单页或区间，`--dpi` 控制栅格化精度）。

设计约束（不要在本文件里打破）：

1. 只依赖 Python 标准库（argparse / subprocess / json / os / sys / shutil /
   pathlib / tempfile / base64 / urllib）。这样 `bin/eimg-ocr-setup` 可以在任何
   系统 python 下复用探测逻辑，不必先装依赖。
   **ollama 后端新增的 `urllib.request` / `urllib.error` / `base64` 仍是标准库，
   stdlib-only 约定未破**（因此也不允许为了 HTTP 便利去引 requests / httpx）。
2. **模块顶层零 I/O、零副作用**：`bin/eimg-ocr-setup`（后续任务）会从本文件里
   取 `probe_backends` 复用，`import` 那一刻不能跑任何探测、不能读配置文件、
   不能起子进程。因此路径常量一律写成字面量，路径展开放在函数内部延迟做。

   **加载方式有个坑**：本文件没有 `.py` 后缀，`importlib.util.spec_from_file_location`
   单独用会因为推不出 loader 而返回 loader 为 None 的 spec（`module_from_spec`
   直接 AttributeError）。必须显式给 SourceFileLoader：

       loader = importlib.machinery.SourceFileLoader("eimg_ocr_cli", path)
       spec = importlib.util.spec_from_loader(loader.name, loader)
       mod = importlib.util.module_from_spec(spec)
       loader.exec_module(mod)          # 此后 mod.probe_backends(...) 可用
3. 未接入识别引擎的后端路径必须**干净失败**（退出码 4），不允许抛 traceback，
   也不允许假装成功。
4. **本进程永不 `import rapidocr`**（同理也不 import numpy / PIL）：CLI 跑在系统
   python 上，那些库只装在某个 venv 里，硬 import 只会让 CLI 在缺少依赖时直接崩。
   识别一律 `subprocess` 起「探测到的目标解释器」去跑内联脚本，见 `run_rapidocr`。
5. **识别结果走临时文件，不走 stdout**：rapidocr 会往 stdout 打一排 `[INFO]` 日志
   （模型路径、engine 名），解析 stdout 必然被日志污染。故内联脚本把 JSON 写进
   临时文件，父进程读文件再 `json.loads`。
6. **tesseract 反过来：只解析 stdout 的 TSV、绝不解析 stderr**：tesseract 把识别
   结果写 stdout、把 `Estimating resolution as ...` 之类日志写 stderr，两条流
   必须用 `capture_output=True` 分开取。之所以统一走 TSV（而不是另跑一次纯文本
   模式），是为了让 text / lines / json 三种格式都由**同一份 blocks** 派生——
   跑两次会让两种格式的内容在版本或参数差异下静默不一致。
7. **PDF 每页单独识别、页码取真实页码**：`pages[i]["page"]` 是 PDF 里的页号，
   不是数组下标（`--pdf-pages 2` → `pages[0]["page"] == 2`）。下游 elisp 侧要
   按页号回填文件名（`report.pdf` 第 3 页），用下标会让选区页码整体偏移。
8. **栅格化临时目录必须 finally 清理**：一份 200 dpi 的 10 页 PDF 拆出的 PNG 有
   十几 MB，失败路径（超时 / Ctrl-C / 后端报错）漏删会持续堆积在 /tmp。
9. **ollama 后端的 HTTP 必须绕代理、且探测永不 raise**：本机 `no_proxy` 未设置，
   裸用 `urlopen` 会把 `127.0.0.1:11434` 的请求交给 `http_proxy`（表现为「服务在跑
   却报不可达」），故一律 `build_opener(ProxyHandler({}))`。探测阶段的任何异常
   （连不上 / 超时 / 坏 JSON）都转成 `available=false` + 人读 `reason`，绝不冒泡到
   `main`——`--list-backends` 与 `eimg-ocr-setup --check` 走的就是这条路径。
   同一条路径上还有三条硬边界：**不跟随重定向**（`_NoRedirect`；跟过去等于把带
   图片的请求体发给任意 `Location`）、**地址只收 http/https 且拒绝 `user:pass@`**
   （`_validate_ollama_url`；凭据会进日志）、**响应体与图片各有大小上限**
   （`_read_capped` / `OLLAMA_MAX_IMAGE`；对端不可信时不能无限读）。
"""

from __future__ import annotations

import argparse
import base64
import http.client
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

PROG = "eimg-ocr"

# ─── 退出码契约（与 openspec 计划 D3 一致，elisp 侧依赖这些数值，不要改动） ───
EXIT_OK = 0            # 成功
EXIT_NO_BACKEND = 2    # 无可用 OCR 后端（stderr 含「未找到可用的 OCR 后端」）
EXIT_BAD_INPUT = 3     # 输入不可读 / 不存在 / 不支持格式 / 页码越界（含「无法读取输入」）
EXIT_OCR_FAILED = 4    # 识别失败（含「识别失败」）
EXIT_BAD_ARGS = 5      # 参数错误（含「参数错误」）

DEFAULT_LANG = "chi_sim+eng"
DEFAULT_DPI = 200

# ollama 服务的默认地址。取 ollama 自己的默认监听（`127.0.0.1:11434`）：本机
# WSL2 是 mirrored 网络，Windows 侧服务经 `127.0.0.1` 直通可达，不必换成宿主 IP。
DEFAULT_OLLAMA_URL = "http://127.0.0.1:11434"

# 所有临时目录统一用这个前缀（栅格化产物 / rapidocr 脚本与结果文件），
# 便于 `ls -d /tmp/eimg-ocr-*` 做泄漏排查，也便于测试断言清理干净。
TEMP_PREFIX = "eimg-ocr-"

# 顺序即 `auto` 后端的优先级顺序：rapidocr 对中文截图质量更好、且本机已装，故排第一；
# ollama 视觉模型质量高于 tesseract 但需显式配置模型，故居中；tesseract 兜底。
BACKEND_ORDER = ("rapidocr", "ollama", "tesseract")

# 输入格式白名单：只放图片与 PDF，不做「任意扩展名都试一下」的猜测。
SUPPORTED_SUFFIXES = (
    ".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tif", ".tiff", ".gif", ".pdf",
)

# ollama 分支的扩展名白名单（比 SUPPORTED_SUFFIXES 窄）。理由：CLI 无 PIL 无法
# 转码，而 ollama 对 tiff / gif / webp 的解码支持不确定（未实测）；明确拒绝比让它
# 静默失败或返回乱码好。PDF 栅格化产物恒为 png，故 PDF 路径不受影响。
OLLAMA_SUFFIXES = (".png", ".jpg", ".jpeg")

# 识别提示词：显式要求「只输出文字」，因为 VLM 默认爱加解释性前缀、编号或代码块。
# 后续的围栏剥离与空行丢弃只是兜底，不能替代这条约束。
OLLAMA_PROMPT = (
    "识别这张图片中的所有文字，按阅读顺序逐行输出。只输出文字本身，不要任何解释、"
    "不要 Markdown 代码块、不要行号或标注。没有文字时输出空字符串。"
)

# 计划 D4 定的已知 venv：pdf-toc-ocr 里已经装好 rapidocr，首轮复用它避免重复下载。
KNOWN_VENV_PYTHON = "/home/thomas/Workspace/pdf-toc-ocr/.venv/bin/python"

# eimg 自己的安装目录名（与 `bin/eimg-ocr-setup` 的 `TESSDATA_DIR_NAME` 一致）：
# `--tessdata` 把语言数据下到 `<data>/eimg/tessdata/`，这里默认就去那儿找。
TESSDATA_DIR_NAME = "tessdata"

# rapidocr 导入探测的超时：onnxruntime 首次 import 会加载共享库，冷启动可达数秒，
# 60 秒是「慢但正常」与「卡死」的分界。
RAPIDOCR_PROBE_TIMEOUT = 60
TESSERACT_PROBE_TIMEOUT = 30

# 单张图识别超时。rapidocr 初始化要加载 det / cls / rec 三个 onnx 模型，本机实测
# 端到端 1.5–2.0 秒（模型已就绪、页缓存热），但首次下载 / 冷缓存 / 慢盘可到十余秒，
# 大图还有上限之外的波动；180 秒给这些留足余量，同时仍是「卡住」与「慢」的可靠
# 分界（超时按退出码 4 处理，不无限挂起）。
RAPIDOCR_TIMEOUT = 180

# 单张图 tesseract 识别超时。本机实测单图（1200x400）约 0.3 秒；语言模型首次
# 加载、大图（A4 300dpi）与慢盘会到数秒级。120 秒给这些留足余量，同时仍是
# 「卡住」与「慢」的可靠分界（超时按退出码 4 处理，不无限挂起）。
TESSERACT_TIMEOUT = 120

# ollama 探测超时（`/api/show` / `/api/tags`）。这两个接口只查模型元数据，服务在跑时
# 本机实测毫秒级；服务没起来是毫秒级 ECONNREFUSED。3 秒只为兜住「防火墙丢包 / 服务
# 半死」——探测挂在 `--list-backends` 与 `eimg-ocr-setup --check` 的关键路径上，
# 不能让一次探测把体检拖成分钟级。
OLLAMA_PROBE_TIMEOUT = 3

# 单张图 ollama 识别超时。VLM 首次推理要把权重读进显存 / 内存（数 GB 级）、首次跑
# 还可能触发模型加载，比 rapidocr / tesseract 慢一到两个数量级；本机无视觉模型可
# 实测（计划明确本轮不下载），故按「宁可等」取 300 秒，同时仍是「卡住」与「慢」的
# 分界（超时按退出码 4 处理，不无限挂起）。
OLLAMA_TIMEOUT = 300

# ollama 响应体上限（16 MB）。ollama 的 JSON 响应是纯文本 + 元数据，本机实测
# `/api/show` 数 KB、`/api/chat` 单页文本几十 KB，远小于此；上限只用于兜住
# 「异常 / 恶意对端」——没有上限时对方一个无限流就能把本进程内存吃干并让
# `--list-backends` 挂死（`OLLAMA_PROBE_TIMEOUT` 只约束单次 socket 操作，
# 挡不住慢速滴流）。超出按识别失败处理。
OLLAMA_MAX_RESPONSE = 16 * 1024 * 1024

# 单张图片大小上限（32 MB）。图片要整份 base64 进请求体，base64 又把体积放大 4/3；
# 32 MB 已远超实际截图（1920x1080 PNG 约 1–3 MB），上限只防「误传大文件」——
# 明确拒绝比让它读满内存、再被对端 413 更可预期。
OLLAMA_MAX_IMAGE = 32 * 1024 * 1024

# `pdfinfo` 取页数超时。它只读 xref 表，本机实测毫秒级；5 秒已是「异常」的判据。
# 超时按「拿不到页数」处理（返回 None，走 pdftoppm 兜底判据），不算识别失败——
# 页数只用于把越界报错说清楚，拿不到不该阻断整条识别路径。
PDFINFO_TIMEOUT = 5

# 整本 PDF 栅格化超时。单页 200 dpi 实测 0.2 秒量级，10 页约 2 秒；但扫描版
# 大页（A3 600dpi）、慢盘与超大页数会显著变长。600 秒给「一本书」留余量，
# 同时仍是「卡住」与「慢」的可靠分界（超时按退出码 4 处理）。
PDF_RASTER_TIMEOUT = 600

# pdftoppm 对「起始页 > 文档末页」的区间返回这个退出码（实测 26.10.0），
# stderr 形如 `Wrong page range given: the first page (9) can not be after the
# last page (3).`。它是「页码越界」的可靠信号，与真正的渲染失败区分开。
PDFTOPPPM_PAGE_RANGE_ERROR = 99


class EimgError(Exception):
    """携带退出码的可预期失败。main() 统一捕获后打印 stderr 并返回退出码。"""

    def __init__(self, code: int, message: str) -> None:
        super().__init__(message)
        self.code = code
        self.message = message


def warn(message: str) -> None:
    """所有 stderr 输出统一走这里，保证 `eimg-ocr: ` 前缀不遗漏。"""
    print(f"{PROG}: {message}", file=sys.stderr)


def fail(code: int, message: str) -> "EimgError":
    return EimgError(code, message)


# ─── 参数解析 ────────────────────────────────────────────────────────────────


class EimgArgumentParser(argparse.ArgumentParser):
    """把 argparse 的「参数错误」映射到退出码 5。

    argparse 默认对任何参数错误调用 `self.exit(2, ...)`，而退出码 2 在本 CLI 里
    表示「无可用后端」。不覆盖的话，`--bogus` 会被上游误读成后端缺失，转而提示
    用户去装 OCR 依赖——排查方向直接跑偏。`--help` 走 `print_help()` + `exit(0)`，
    不经过 `error()`，因此不受影响。
    """

    def error(self, message: str) -> None:  # noqa: A003  (覆盖基类同名方法)
        self.print_usage(sys.stderr)
        self.exit(EXIT_BAD_ARGS, f"{PROG}: 参数错误: {message}\n")


def parse_lang(value: str) -> list[str]:
    """把 tesseract 风格的语言串拆成列表：`chi_sim+eng` → `["chi_sim", "eng"]`。"""
    langs = [part.strip() for part in value.split("+")]
    langs = [part for part in langs if part]
    if not langs:
        raise argparse.ArgumentTypeError("--lang 不能为空（示例: chi_sim+eng）")
    return langs


def parse_positive_int(value: str) -> int:
    try:
        number = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"需要正整数，实际是 {value!r}")
    if number <= 0:
        raise argparse.ArgumentTypeError(f"需要正整数，实际是 {value!r}")
    return number


def parse_pdf_pages(value: str) -> list[int]:
    """解析 `1-5` 或 `3` 形式的页码范围（1-based，闭区间）。

    这里只管语法与「页码 ≥ 1」「区间不倒序」。「页码是否超过文档实际页数」需要
    先知道真实页数，由 `pdf_page_count`（pdfinfo）或 pdftoppm 的越界信号在
    `recognize_pdf` 里判定 → 退出码 3。
    """
    text = value.strip()
    if not text:
        raise argparse.ArgumentTypeError("--pdf-pages 不能为空（示例: 1-5 或 3）")
    if "-" in text:
        start_text, _, end_text = text.partition("-")
        try:
            start, end = int(start_text), int(end_text)
        except ValueError:
            raise argparse.ArgumentTypeError(f"页码范围格式错误: {value!r}（示例: 1-5）")
        if start < 1 or end < 1:
            raise argparse.ArgumentTypeError(f"页码从 1 开始: {value!r}")
        if end < start:
            raise argparse.ArgumentTypeError(f"页码范围倒序: {value!r}（示例: 1-5）")
        return list(range(start, end + 1))
    try:
        page = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"页码格式错误: {value!r}（示例: 1-5 或 3）")
    if page < 1:
        raise argparse.ArgumentTypeError(f"页码从 1 开始: {value!r}")
    return [page]


def build_parser() -> EimgArgumentParser:
    parser = EimgArgumentParser(
        prog=PROG,
        description=(
            "eimg 统一 OCR CLI（图片与 PDF 均可识别；PDF 经 pdftoppm 栅格化后逐页识别）。"
        ),
        epilog=(
            "退出码: 0 成功 / 2 无可用后端 / 3 输入不可读（含页码越界） / "
            "4 识别失败 / 5 参数错误。"
        ),
    )
    parser.add_argument(
        "files",
        nargs="*",
        metavar="FILE",
        help="待识别文件（png/jpg/jpeg/webp/bmp/tif/tiff/gif/pdf）；给 --list-backends 时可省略",
    )
    parser.add_argument(
        "--backend",
        choices=BACKEND_ORDER + ("auto",),
        default="auto",
        help="后端选择（默认 auto：按 rapidocr → ollama → tesseract 顺序取第一个可用者）",
    )
    parser.add_argument(
        "--lang",
        type=parse_lang,
        default=parse_lang(DEFAULT_LANG),
        metavar="LANGS",
        help=(
            f"识别语言，tesseract 语法（默认 {DEFAULT_LANG}）；"
            "rapidocr 忽略此参数（其模型固定中英文），传了也不会报错"
        ),
    )
    parser.add_argument(
        "--format",
        choices=("text", "json", "lines"),
        default="text",
        help=(
            "输出形态（默认 text：按页输出、页间以 \\f 分隔；"
            "lines：每行一条文本；json：结构化）"
        ),
    )
    parser.add_argument(
        "--pdf-pages",
        type=parse_pdf_pages,
        default=None,
        metavar="PAGES",
        help=(
            "PDF 只识别指定页，如 1-5 或 3（默认全部页）；页码越界退出码 3。"
            "对图片输入无意义，会被忽略"
        ),
    )
    parser.add_argument(
        "--dpi",
        type=parse_positive_int,
        default=DEFAULT_DPI,
        metavar="N",
        help=f"PDF 栅格化 DPI（默认 {DEFAULT_DPI}）",
    )
    parser.add_argument(
        "--page-images-dir",
        default=None,
        metavar="DIR",
        help=(
            "把 PDF 每页栅格化后的 PNG 落到 DIR（命名 <源文件名>-p<页码>.png），"
            "并在 json 的每一页输出 image 绝对路径，供「原图与坐标对齐」使用；"
            "图片输入则直接输出输入图的绝对路径（不复制）。"
            "DIR 不存在会自动创建。不传则该字段不出现，输出与旧版一致"
        ),
    )
    parser.add_argument(
        "--python",
        default=None,
        metavar="PATH",
        help=(
            "rapidocr 解释器路径；给了就只用它（不再探测环境变量 / 配置文件 / "
            "PATH / 已知 venv），路径无效即视为 rapidocr 不可用"
        ),
    )
    parser.add_argument(
        "--tessdata-dir",
        default=None,
        metavar="PATH",
        help=(
            "tesseract 语言数据目录（透传给 --list-langs 与识别命令）；不给时先用"
            "系统默认，若 eimg 安装目录（<data>/eimg/tessdata）里已有语言数据则用它"
        ),
    )
    parser.add_argument(
        "--list-backends",
        action="store_true",
        help="列出后端可用性后退出（查询动作，无论是否有可用后端都返回 0）",
    )
    parser.add_argument(
        "--ollama-model",
        default=None,
        metavar="NAME",
        help=(
            "ollama 视觉模型名（如 qwen2.5-vl:7b）；「未配置即判 ollama 不可用」——"
            "本 CLI 不自动挑 vision 模型、也不写死默认模型名。也可写在 config.json 的 "
            "ollama_model 键里，此处显式给出则以这里为准"
        ),
    )
    parser.add_argument(
        "--ollama-url",
        default=None,
        metavar="URL",
        help=(
            f"ollama 服务地址（默认 {DEFAULT_OLLAMA_URL}；也可写在 config.json 的 "
            "ollama_url 键里，此处显式给出则以这里为准）"
        ),
    )
    return parser


# ─── 后端探测 ────────────────────────────────────────────────────────────────


def _data_dir() -> Path:
    """按 XDG 约定算数据目录；延迟到调用时展开，保证 import 期零 I/O。"""
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "share"
    )
    return Path(base) / "eimg"


def _config_path() -> Path:
    """按 XDG 约定算配置路径；延迟到调用时展开，保证 import 期零 I/O。"""
    return _data_dir() / "config.json"


def _installed_tessdata_dir() -> Path | None:
    """eimg 安装目录里的语言数据（`bin/eimg-ocr-setup --tessdata` 的落点）。

    判据是「目录存在 **且** 至少有一个 `*.traineddata`」：只有空目录时把
    `--tessdata-dir` 传下去反而更糟——tesseract 会只在该目录里找语言数据，连系统
    自带的 `osd` 都看不到，报错比不传更费解。
    """
    candidate = _data_dir() / TESSDATA_DIR_NAME
    try:
        if not candidate.is_dir():
            return None
        if next(candidate.glob("*.traineddata"), None) is None:
            return None
    except OSError:
        return None
    return candidate


def resolve_tessdata_dir(explicit: str | None) -> tuple[str | None, str]:
    """返回 `(实际用的语言数据目录, 说明)`，供探测与识别两处共用。

    显式给出（`--tessdata-dir` / elisp 的 `eimg-ocr-tessdata-dir`）时**以显式为准**，
    说明为空串——用户已经指明位置，不该再用「默认使用 eimg 安装目录」误导他。未给
    时自动探测 eimg 安装目录，命中则连同说明返回，让调用方写进 reason。

    为什么要这个默认值：`--tessdata` 把语言数据装到 `<data>/eimg/tessdata/`，而
    tesseract 默认只探 `/usr/share/tessdata`。缺这一步时「装好的语言数据 Emacs 侧
    用不上」，表现为探测 `available=false`——装与用之间差一条隐式约定，很难查。
    """
    if explicit:
        return explicit, ""
    installed = _installed_tessdata_dir()
    if installed is None:
        return None, ""
    return str(installed), f"默认使用 eimg 安装目录: {installed}"


def _config_get(key: str) -> str | None:
    """读配置文件里的字符串键。文件缺失 / 坏 JSON / 非对象 / 键不可用一律返回 None。

    这是配置链「config.json 层」的唯一读取入口：所有键共用同一套容错（读不到就当
    没配，绝不因为一个坏文件让 CLI 崩掉——`bin/eimg-ocr-setup` 写配置是原子替换，
    但用户手工改坏 JSON 的概率不为零）。
    """
    path = _config_path()
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError:
        return None
    try:
        data = json.loads(raw)
    except (ValueError, TypeError):
        return None
    if not isinstance(data, dict):
        return None
    value = data.get(key)
    if isinstance(value, str) and value.strip():
        return value.strip()
    return None


def _config_python() -> str | None:
    """读配置文件里的 `python` 键（`_config_get` 的薄包装，行为与旧实现完全一致）。"""
    return _config_get("python")


def _config_ollama_model() -> str | None:
    """读配置文件里的 `ollama_model` 键（读取规则与 `python` 键同构）。"""
    return _config_get("ollama_model")


def _config_ollama_url() -> str | None:
    """读配置文件里的 `ollama_url` 键（读取规则与 `python` 键同构）。"""
    return _config_get("ollama_url")


def _ollama_model(explicit: str | None) -> str | None:
    """模型名解析链：显式值（CLI / elisp ARGS）> config.json `ollama_model` > 无。

    **没有内置默认模型**（用户拍板「模型必须显式指定」）：返回 None 即表示
    ollama 后端不可用，由 `_probe_ollama` 给出配置指引。
    """
    return explicit or _config_ollama_model()


def _ollama_url(explicit: str | None) -> str:
    """服务地址解析链：显式值 > config.json `ollama_url` > `DEFAULT_OLLAMA_URL`。

    返回值**已过 `_validate_ollama_url` 校验**：三条来源（CLI / config.json / 内置
    默认）在这里汇成唯一出口，所有使用点拿到的都是校验过的地址，不必各自再判一次。
    校验失败抛退出码 5，由调用方决定是「报参数错误」还是「折成后端不可用」。
    """
    return _validate_ollama_url(explicit or _config_ollama_url() or DEFAULT_OLLAMA_URL)


def _validate_ollama_url(url: str) -> str:
    """校验 ollama 服务地址，返回去掉尾部斜杠的规整形态；不合规抛退出码 5。

    三条规则，都在「请求发出去之前」拦：

    1. scheme 只许 `http` / `https`：`file://` / `ftp://` 交给 `urllib` 会变成完全
       不同的行为（读本地文件、走 FTP 驱动），不该由用户随手敲的一个地址开启。
    2. 拒绝 `user:pass@`：这类地址一旦出现在 `reason` / stderr / `*eimg-ocr-backends*`
       buffer 里就是明文密码外泄（`_mask_url` 只是兜底，不是许可证）。ollama 自身
       也不做 HTTP 认证，凭据只能由前置代理校验，那也不该写在这里。
    3. 主机名必须存在且不含空白字符：`http://1 27.0.0.1:11434` 这种笔误在
       `urlsplit` 层是「合法」的（空格原样留在 netloc 里），交给 `urllib` 只会得到
       一条含糊的 `URLError`（表现为「服务不可达」，退出码 2），与「参数写错了」
       是两回事，用户排查方向会被带偏。

    `rstrip("/")` 是必须的：后续一律用 `f"{url}/api/show"` 拼路径，不去尾斜杠会
    拼出 `//api/show`（多数服务容忍，但反代 / 代理规则未必）。
    """
    text = (url or "").strip()
    try:
        parts = urllib.parse.urlsplit(text)
    except ValueError:
        raise fail(EXIT_BAD_ARGS, f"参数错误: --ollama-url 不是合法 URL（收到 {text!r}）")

    scheme = parts.scheme.lower()
    if scheme not in ("http", "https"):
        raise fail(
            EXIT_BAD_ARGS,
            f"参数错误: --ollama-url 只支持 http/https（收到 {scheme or '空 scheme'}://）",
        )

    # 注意：这条文案里**绝不能**回显原地址——它的 userinfo 正是密码。
    if parts.username or parts.password:
        raise fail(
            EXIT_BAD_ARGS,
            "参数错误: --ollama-url 不支持 user:pass@ 形式"
            "（凭据会进日志，请改用代理侧认证）",
        )

    host = parts.hostname or ""
    if not host or any(ch.isspace() for ch in host):
        raise fail(
            EXIT_BAD_ARGS,
            f"参数错误: --ollama-url 主机名非法（收到 {_mask_url(text)!r}）",
        )
    return text.rstrip("/")


def _python_candidates(explicit: str | None) -> list[tuple[str, str]]:
    """按计划 D4 的优先级给出 rapidocr 候选解释器：[(来源标签, 路径), ...]。

    去重按路径文本（同一路径只探测一次），标签保留第一次出现的来源，避免
    `python3` 与 `EIMG_OCR_PYTHON` 指向同一个二进制时重复跑 import。
    """
    raw: list[tuple[str, str]] = [("--python", explicit)] if explicit else [
        ("--python", "未提供")
    ]

    env_python = os.environ.get("EIMG_OCR_PYTHON")
    raw.append(("EIMG_OCR_PYTHON", env_python if env_python else "未设置"))

    cfg_python = _config_python()
    if cfg_python:
        raw.append((str(_config_path()), cfg_python))
    else:
        raw.append((str(_config_path()), "无 python 键或文件不存在"))

    on_path = shutil.which("python3")
    raw.append(("PATH 上的 python3", on_path if on_path else "未找到"))

    raw.append((KNOWN_VENV_PYTHON, KNOWN_VENV_PYTHON))

    candidates: list[tuple[str, str]] = []
    seen: set[str] = set()
    for label, value in raw:
        if not value or value in ("未提供", "未设置", "未找到", "无 python 键或文件不存在"):
            # 占位项也要保留：汇总 reason 时需要体现「这一档查过了」。
            candidates.append((label, value))
            continue
        if value in seen:
            continue
        seen.add(value)
        candidates.append((label, value))
    return candidates


def _check_rapidocr(python_path: str) -> tuple[bool, str]:
    """对单个候选解释器执行一次 `-c "import rapidocr"`。"""
    if not Path(python_path).exists():
        return False, "解释器不存在"
    if not os.access(python_path, os.X_OK):
        return False, "解释器不可执行"
    try:
        # errors="replace"：rapidocr 导入失败时的报错可能夹带非 UTF-8 字节，
        # 不加的话 `text=True' 的解码会抛 UnicodeDecodeError、穿透成 traceback。
        proc = subprocess.run(
            [python_path, "-c", "import rapidocr"],
            capture_output=True,
            text=True,
            errors="replace",
            timeout=RAPIDOCR_PROBE_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        return False, f"导入超时（>{RAPIDOCR_PROBE_TIMEOUT}s）"
    except OSError as exc:
        return False, f"无法执行: {exc.strerror or exc}"
    if proc.returncode == 0:
        return True, ""
    detail = ""
    for line in reversed((proc.stderr or "").strip().splitlines()):
        if line.strip():
            detail = line.strip()
            break
    if not detail:
        detail = f"退出码 {proc.returncode}"
    return False, detail


def _probe_rapidocr(python: str | None) -> dict:
    """探测 rapidocr：按优先级挑解释器，第一个能 `import rapidocr` 的即可用。

    注意本进程自身**绝不** import rapidocr——CLI 跑在系统 python 上，rapidocr
    只可能装在别的环境里，硬 import 只会污染依赖并制造误判。

    `--python` 给定时**只探测它本身**，不再回落到环境变量 / 配置文件 / PATH /
    已知 venv：显式路径是「就用这个解释器」而不是「优先试这个」。否则
    `--python /nonexistent/python` 会被静默替换成已知 venv 并报「可用」，
    用户拼错路径永远暴露不出来，`auto` 也会在错误解释器上悄悄跑起来。
    """
    candidates = [("--python", python)] if python else _python_candidates(None)
    notes: list[str] = []
    for label, value in candidates:
        if not value or value in ("未提供", "未设置", "未找到", "无 python 键或文件不存在"):
            notes.append(f"{label} {value}")
            continue
        ok, detail = _check_rapidocr(value)
        if ok:
            return {"name": "rapidocr", "available": True, "reason": value}
        notes.append(f"{value}: {detail}")
    reason = "未找到可导入 rapidocr 的解释器（已探测: " + ", ".join(notes) + "）"
    return {"name": "rapidocr", "available": False, "reason": reason}


def _tesseract_langs(executable: str, tessdata_dir: str | None) -> tuple[list[str], str]:
    """跑 `tesseract --list-langs` 取语言集合，返回 (语言列表, 错误说明)。"""
    command = [executable, "--list-langs"]
    if tessdata_dir:
        command.extend(["--tessdata-dir", tessdata_dir])
    try:
        # 同 run_tesseract：tesseract 的错误输出可能带非 UTF-8 原始字节。
        proc = subprocess.run(
            command,
            capture_output=True,
            text=True,
            errors="replace",
            timeout=TESSERACT_PROBE_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        return [], f"--list-langs 超时（>{TESSERACT_PROBE_TIMEOUT}s）"
    except OSError as exc:
        return [], f"无法执行 --list-langs: {exc.strerror or exc}"

    langs: list[str] = []
    for line in (proc.stdout or "").splitlines():
        text = line.strip()
        if not text or text.lower().startswith("list of available"):
            continue
        langs.append(text)
    if proc.returncode != 0 and not langs:
        detail = ""
        for line in (proc.stderr or "").strip().splitlines():
            if line.strip():
                detail = line.strip()
                break
        return [], detail or f"--list-langs 退出码 {proc.returncode}"
    return sorted(set(langs)), ""


def _probe_tesseract(lang: list[str] | str, tessdata_dir: str | None) -> dict:
    """探测 tesseract：可执行存在 **且** 请求的语言数据齐全才算可用。

    语言缺失算「不可用」而不是「能用但会报错」——否则 `auto` 会选中一个注定
    识别失败的 tesseract，用户看到的错误会变成含糊的识别失败。

    `tessdata_dir` 未给时按 `resolve_tessdata_dir` 自动落到 eimg 安装目录，并在
    reason 末尾注明（探测结论要能解释「为什么这条可用 / 不可用」）。
    """
    wanted = parse_lang(lang) if isinstance(lang, str) else list(lang)
    effective_dir, dir_note = resolve_tessdata_dir(tessdata_dir)
    executable = shutil.which("tesseract")
    if not executable:
        return {
            "name": "tesseract",
            "available": False,
            "reason": "未在 PATH 上找到 tesseract",
        }

    version = ""
    try:
        proc = subprocess.run(
            [executable, "--version"],
            capture_output=True,
            text=True,
            errors="replace",
            timeout=TESSERACT_PROBE_TIMEOUT,
        )
        for line in (proc.stdout or "").splitlines():
            if line.strip():
                version = line.strip()
                break
    except (subprocess.TimeoutExpired, OSError):
        # --version 失败不影响可用性判定（存在性已由 which 确认），
        # 但要在 reason 里体现拿不到版本号。
        version = "版本未知"

    langs, lang_error = _tesseract_langs(executable, effective_dir)
    # 失败分支也带上「查的是哪个目录」：缺语言数据时最需要的正是这个信息——
    # 用户得知道探测看的是 eimg 安装目录还是 tesseract 的系统默认目录。
    suffix = f"；{dir_note}" if dir_note else ""
    if lang_error:
        return {
            "name": "tesseract",
            "available": False,
            "reason": (
                f"tesseract 存在但缺 {'/'.join(wanted)} 语言数据"
                f"（语言列表取不到: {lang_error}）{suffix}"
            ),
        }

    missing = [item for item in wanted if item not in langs]
    if missing:
        present = ", ".join(langs) if langs else "无"
        return {
            "name": "tesseract",
            "available": False,
            "reason": (
                f"tesseract 存在但缺 {'/'.join(missing)} 语言数据（现有: {present}）{suffix}"
            ),
        }
    detail = f"{version or 'tesseract'}；语言齐全: {'/'.join(wanted)}"
    if dir_note:
        detail = f"{detail}；{dir_note}"
    return {
        "name": "tesseract",
        "available": True,
        "reason": detail,
    }


def _ollama_timed_out(exc: BaseException) -> bool:
    """判断异常是否为超时。

    要沿 `reason` 看一层：`urlopen` 在连接 / 发送阶段把 `socket.timeout` 包成
    `URLError(reason=timeout)`，而读取响应体阶段是直接抛 `TimeoutError`（`OSError`
    子类）。只看顶层类型会把「连接超时」误报成「连不上服务」。
    """
    candidate: object = exc
    for _ in range(2):
        if isinstance(candidate, (TimeoutError, socket.timeout)):
            return True
        candidate = getattr(candidate, "reason", None)
    return False


def _ollama_error_text(exc: BaseException) -> str:
    """把网络异常压成一行短原因——`reason` 要能塞进 `--list-backends` 的单行输出。"""
    reason = getattr(exc, "reason", None)
    text = str(reason if reason is not None else exc).strip()
    return _last_line(text) or exc.__class__.__name__


def _mask_url(url: str) -> str:
    """把 URL 里的 userinfo 抹成 `***`，其余原样。

    reason / stderr 会进 `*eimg-ocr-backends*` buffer 与用户贴出的排障日志，
    形如 `http://user:pass@host` 的地址必须脱敏，否则密码明文外泄。

    `_validate_ollama_url` 已经在入口拒掉带 userinfo 的地址，这里是**兜底**：
    兜底之所以不能省，是因为来源不止一条（config.json、`import` 本模块的
    `bin/eimg-ocr-setup`、将来可能的其它入口），漏一处就是一次密码进日志。
    正则只吃 `//` 之后到 `@` 之间、不含 `/` 与空白的段，故正常无 `@` 的 URL
    逐字不变（`http://127.0.0.1:11434` 不会被改动）。
    """
    return re.sub(r"(?<=//)[^/@\s]*@", "***@", url or "")


class _OllamaRedirect(Exception):
    """服务端返回了重定向——内部信号，由调用方翻成人读文案。

    为什么不用 `fail(...)` 直接抛：`_ollama_http` 同时服务「探测」与「识别」两条
    路径，探测路径要求**永不 raise**（否则 `--list-backends` 会变成退出码 4），
    识别路径要求「重定向 = 识别失败 4」。同一个事件在两处必须给不同结论，故先抛
    一个中性的内部异常，由各路径自己决定文案与退出码。
    """

    def __init__(self, code: int) -> None:
        super().__init__(code)
        self.code = code


class _OllamaResponseTooLarge(Exception):
    """响应体超过 `OLLAMA_MAX_RESPONSE`——内部信号，理由同 `_OllamaRedirect`。"""

    def __init__(self, size: int, limit: int) -> None:
        super().__init__(size)
        self.size = size
        self.limit = limit


class _OllamaDeadlineExceeded(Exception):
    """整体预算（`timeout` 秒）耗尽——内部信号，理由同 `_OllamaRedirect`。

    **为什么继承 `Exception` 而不是 `OSError` / `TimeoutError`**：`_ollama_http` 的
    调用方（`_probe_ollama` / `run_ollama` / `_ollama_installed_models`）都有一层
    `except (urllib.error.URLError, OSError, ValueError, http.client.HTTPException)`
    兜底，把网络层异常统一说成「服务不可达 / 连不上」。`TimeoutError` 是 `OSError`
    的子类，若本异常也走那条继承链，它一定会被**先**吞进兜底分支，用户看到的就变成
    「无法连接 ollama 服务」，而真实原因是「服务通但太慢」——这两件事的排查方向完全
    不同（前者查地址 / 防火墙，后者查模型是否在跑、图片是否太大、机器是否太慢）。
    继承普通 `Exception` 让它在兜底链之外，各调用方必须显式写一个分支来处理它。

    字段 `timeout` 是**整体预算的秒数**（不是剩下的秒数），用于人读文案。
    """

    def __init__(self, timeout: float) -> None:
        super().__init__(timeout)
        self.timeout = timeout


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """把所有 3xx 重定向直接拒掉。

    默认的 `HTTPRedirectHandler` 会跟着 `Location` 走：对 ollama 这种「本地可信
    服务」的假设下，跟随重定向等于把**请求体（含整张图片的 base64）**发到
    `Location` 指向的任意主机。本包不认为对端可信到可以替我们选目标，故一律拒绝。
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: D401
        raise _OllamaRedirect(int(code))


def _read_capped(
    response,
    limit: int = OLLAMA_MAX_RESPONSE,
    deadline: float | None = None,
    timeout: float | None = None,
) -> str:
    """有界读取响应体，超过 LIMIT 抛 `_OllamaResponseTooLarge`；返回解码后文本。

    两道闸：先看 `Content-Length`（声明就超限的直接拒，一个字节的 body 都不用读，
    这也是测试里 `huge` 模式能动辄声明几十 MB 而不真传的原因），再逐块读兜住
    「没声明长度 / 声明撒谎」的流式响应——多读 1 字节是为了区分「正好等于上限」与
    「超了」，这个 `limit + 1` 的边界语义在两条路径上一致。

    **两种读取路径**：

    - `deadline is None`：一次性 `read(limit + 1)`，保持本函数最初的语义。向后
      兼容保留（不传预算的调用方行为不变），但**不是**主路径——`read(n)` 的语义是
      「读满 n 字节或 EOF」，慢速滴流响应下每次读都有数据进来，永远不触发 socket
      超时，会一直阻塞到对端放手或 EOF，给不出硬上限。
    - `deadline` 非 None：按整体预算分块读，**每块前**先查预算，耗尽即抛
      `_OllamaDeadlineExceeded`。分块用的是 `read1(n)`：它只做一次底层读并返回当前
      可用的字节，不等待凑满 n——这才是「每块之间能回到 Python 层查预算」的前提。
      `read1` 是 `http.client.HTTPResponse` 的方法，`HTTPError` 路径上的对象不一定
      有（故用 `getattr` 探测，缺失时回退 `read(min(n, 4096))`；**残余风险**：回退
      路径上单次 `read` 仍可能阻塞到凑满 4096 字节或 EOF，慢速滴流下预算只能保证
      「两次底层读之间」被检查，最坏多等一次底层读的时间）。
    - `timeout` 只用于异常文案（`_OllamaDeadlineExceeded.timeout` 要报出「上限 N 秒」，
      而 `deadline` 是个单调时钟的绝对时间点，反推不出原始预算）。传 `deadline`
      就应一并传 `timeout`。

    `errors="replace"`：对端返回非 UTF-8 的中文编码时也要能给出可读报错，而不是
    在这里抛 `UnicodeDecodeError`（那会穿透成 traceback）。
    """
    declared = None
    try:
        raw_length = response.headers.get("Content-Length") if response.headers else None
        if raw_length is not None:
            declared = int(raw_length)
    except (TypeError, ValueError):
        # 声明值不可解析：退回「按实际读到的字节数」判定，不在这里失败。
        declared = None
    if declared is not None and declared > limit:
        raise _OllamaResponseTooLarge(declared, limit)

    if deadline is None:
        raw = response.read(limit + 1)
        if len(raw) > limit:
            raise _OllamaResponseTooLarge(len(raw), limit)
        return raw.decode("utf-8", "replace")

    # `budget` 只用于异常文案：`deadline` 非 None 时它本该一起给出（本文件的三个调用点
    # 都传），缺失时异常里的 `timeout` 就是 None——不去编一个假秒数糊弄日志。
    budget = timeout
    reader = getattr(response, "read1", None)
    chunks: list[bytes] = []
    total = 0
    while True:
        if time.monotonic() >= deadline:
            raise _OllamaDeadlineExceeded(budget)
        # 单次上限取 `limit + 1 - total`：读满 `limit + 1` 字节就必然超限，不必多读。
        want = min(64 * 1024, limit + 1 - total)
        if reader is not None:
            chunk = reader(want)
        else:
            chunk = response.read(min(want, 4096))
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
        if total > limit:
            raise _OllamaResponseTooLarge(total, limit)
    return b"".join(chunks).decode("utf-8", "replace")


def _ollama_http(url: str, payload: dict | None, timeout: int) -> tuple[int, str]:
    """请求 ollama 的 JSON 接口，返回 `(HTTP 状态码, 响应体文本)`。

    - `payload is None` 时发 GET，否则发 POST JSON（`Content-Type: application/json`）。
    - **必须绕过代理**：本机 `no_proxy` 未设置，裸 `urlopen` 会把 `127.0.0.1` 的请求
      交给 `http_proxy`，表现为「本地服务在跑却报不可达 / 假 503」。
      `ProxyHandler({})` 给一张空代理表是唯一可靠的绕法。
    - **必须拒绝重定向**：见 `_NoRedirect`——跟随 3xx 会把带图片的请求体发去
      任意 `Location`。
    - HTTP 错误码**不抛异常**而是照常返回：`404` 的响应体里带着
      `{"error": "model ... not found"}`，那正是「模型未安装」分支的判据。
    - 响应体**有界读取**（`_read_capped`）：成功与 `HTTPError` 两条路径都不能
      `read()` 到底。
    - **`timeout` 是整体预算，不是单次 socket 操作超时**：连接、发送、读取响应体
      共用同一笔预算。单次 socket 超时对「慢速滴流」响应完全无效——对端每次底层读
      都有数据进来，socket 永远不会超时，调用方会被吊到对端自己放手为止（`read(n)`
      要凑满 n 字节或 EOF 才返回）。故这里算一个 `deadline`，由 `_read_capped` 逐块
      查预算，耗尽抛 `_OllamaDeadlineExceeded`（整体超时）。
    - 网络层失败（连不上 / 超时 / DNS）仍向上抛，由调用方决定文案；
      `_OllamaRedirect` / `_OllamaResponseTooLarge` / `_OllamaDeadlineExceeded`
      也原样向上抛（内部信号）。
    """
    data = None
    headers: dict[str, str] = {}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers)
    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({}), _NoRedirect()
    )
    deadline = time.monotonic() + timeout
    remaining = max(0.0, deadline - time.monotonic())
    if remaining <= 0:
        # 预算一开始就耗尽时**不调用** `opener.open`：把它当 socket 超时传下去，
        # `socket.settimeout(0)` 在 CPython 里抛 ValueError（非正数），会被下面的
        # 兜底说成「地址坏了 / 服务不可达」，与真实原因（预算用完）完全不符。
        raise _OllamaDeadlineExceeded(timeout)
    try:
        with opener.open(request, timeout=remaining) as response:
            status = getattr(response, "status", None) or response.getcode()
            return int(status), _read_capped(
                response, deadline=deadline, timeout=timeout
            )
    except urllib.error.HTTPError as exc:
        # 顺序要紧：HTTPError 是 URLError 的子类，先捕获它才不会把 404 当连接失败。
        try:
            body = _read_capped(exc, deadline=deadline, timeout=timeout)
        except (
            _OllamaRedirect,
            _OllamaResponseTooLarge,
            # 整体超时同理：错误响应体读到一半预算耗尽，也必须让调用方看见，
            # 否则会被下面的 `except (OSError, ValueError)` 吞成 `body=""`。
            _OllamaDeadlineExceeded,
        ):
            # 策略性拒绝（重定向 / 响应过大 / 整体超时）必须让调用方看见。
            raise
        except (OSError, ValueError):
            # 错误响应体读不出来（连接已断 / 已超时）不该掩盖状态码本身：404 的
            # 判据仍然成立，只是少了响应体里的 `error` 文案。
            body = ""
        return int(exc.code), body



def _ollama_installed_models(url: str) -> str:
    """`GET {url}/api/tags` 取已装模型名，拼成一行（仅「模型未安装」分支调用）。

    只在失败分支发一次这个请求：成功路径靠一次 `/api/show` 就能定性，多一次往返
    没有收益，而 `--list-backends` 已经在探测上多花了时间。
    """
    try:
        status, body = _ollama_http(f"{url}/api/tags", None, OLLAMA_PROBE_TIMEOUT)
    except (
        urllib.error.URLError,
        OSError,
        ValueError,
        http.client.HTTPException,  # 对端提前关连接 / 坏 chunk 头（IncompleteRead 等）
        _OllamaRedirect,  # 「已装列表」只是辅助信息，重定向不值得让整条探测失败
        _OllamaResponseTooLarge,
        # 整体超时同理：它是「辅助信息拿不到」，不能让 `_probe_ollama`（文档承诺
        # 永不 raise）在这个分支上冒出异常——那时用户连「模型未安装」都看不到。
        _OllamaDeadlineExceeded,
    ):
        return "（无法获取）"
    if status != 200:
        return "（无法获取）"
    try:
        data = json.loads(body)
    except (ValueError, TypeError):
        return "（无法获取）"
    if not isinstance(data, dict) or not isinstance(data.get("models"), list):
        return "（无法获取）"
    names: list[str] = []
    for item in data["models"]:
        if not isinstance(item, dict):
            continue
        for key in ("name", "model"):
            value = item.get(key)
            if isinstance(value, str) and value.strip():
                names.append(value.strip())
                break
    return ", ".join(names) if names else "（无）"


def _probe_ollama(model: str | None, url: str) -> dict:
    """探测 ollama：服务可达 **且** 指定模型已装 **且** 该模型带 vision 能力才可用。

    返回的 entry 除通用的 `name` / `available` / `reason` 外**额外**带 `model` 与
    `url`：识别阶段要复用它们（`auto` 选中 ollama 时 `args.ollama_model` 可能是
    None，值来自 config.json），而 `reason` 只放人读文案——rapidocr 用 `reason` 传
    解释器路径，语义不同不能混用。

    **本函数永不 raise**：连不上 / 超时 / 坏 JSON 一律折成 `available=False` +
    明确 reason。只有 `resolve_backend` 才会因为「后端不可用」抛退出码 2。
    """
    entry = {
        "name": "ollama",
        "available": False,
        "reason": "",
        "model": model,
        "url": url,
    }

    # 分支 1：未配置模型。此分支**不发任何网络请求**——没模型时连服务在不在都没意义，
    # 而 `--list-backends` 不该因为缺配置就多等一次超时。
    if not model:
        entry["reason"] = (
            "未配置 ollama 模型：用 --ollama-model NAME 或 config.json 的 ollama_model 键指定"
        )
        return entry

    try:
        status, body = _ollama_http(
            f"{url}/api/show", {"model": model}, OLLAMA_PROBE_TIMEOUT
        )
    except _OllamaRedirect as exc:
        # 分支 2a：服务端要重定向。探测侧**不能**按「识别失败」报，只能判不可用。
        entry["reason"] = (
            f"ollama 服务返回重定向（HTTP {exc.code}），已拒绝跟随"
            f"（{_mask_url(url)}）"
        )
        return entry
    except _OllamaResponseTooLarge as exc:
        # 分支 2b：响应体超限。同样是「对端不像 ollama」的信号，判不可用。
        entry["reason"] = (
            f"ollama 响应体过大（{exc.size} 字节，上限 {exc.limit}）"
            f"（{_mask_url(url)}）"
        )
        return entry
    except _OllamaDeadlineExceeded as exc:
        # 分支 2b-2：整体预算（`OLLAMA_PROBE_TIMEOUT` 秒）耗尽。必须与 2c 区分开：
        # 2c 是「连不上」，这里是「连上了但太慢」（典型成因是慢速滴流响应——对端
        # 每隔一段吐一个字节，单次 socket 超时永远不会触发）。两者排查方向不同，
        # 合成一句「服务不可达」会让用户去查防火墙。
        entry["reason"] = (
            f"ollama 探测整体超时（上限 {exc.timeout} 秒）（{_mask_url(url)}）"
        )
        return entry
    except (
        urllib.error.URLError,
        OSError,
        ValueError,
        http.client.HTTPException,
    ) as exc:
        # 分支 2c：服务不可达（连接失败 / 超时 / 坏 HTTP 报文）。
        entry["reason"] = (
            f"ollama 服务不可达（{_mask_url(url)}）：{_ollama_error_text(exc)}"
        )
        return entry

    parsed: object = None
    if body.strip():
        try:
            parsed = json.loads(body)
        except (ValueError, TypeError):
            parsed = None

    error_field = ""
    if isinstance(parsed, dict):
        raw_error = parsed.get("error")
        if isinstance(raw_error, str):
            error_field = raw_error

    # 分支 3：模型未安装。判据是 404，或 error 字段里明确说 not found——服务端对
    # 「模型不存在」的两种表达方式都要认，否则老版本 ollama 会掉进「探测失败」分支。
    if status == 404 or "not found" in error_field.lower():
        installed = _ollama_installed_models(url)
        entry["reason"] = (
            f"模型 {model} 未安装（{_mask_url(url)}）；已装：{installed}；"
            f"用 ollama pull {model} 安装"
        )
        return entry

    # 分支 4：其它非 200（500 / 503 等）。带响应体前 200 字符，便于用户贴日志排查。
    if status != 200:
        entry["reason"] = f"ollama 探测失败（HTTP {status}）：{body[:200]}"
        return entry

    if not isinstance(parsed, dict):
        # 200 但不是 JSON 对象：多半是反代塞进来的 HTML 错误页。
        entry["reason"] = (
            f"ollama 探测失败（HTTP 200 但响应不是 JSON 对象）：{body[:200]}"
        )
        return entry

    capabilities = parsed.get("capabilities")
    # 分支 5a：capabilities 缺失 / 非 list。按「不支持视觉」处理，但文案要点明成因——
    # 老版本 ollama 不返回该字段，「缺少字段」与「明确不支持」对用户是两回事。
    if not isinstance(capabilities, list):
        entry["reason"] = (
            f"模型 {model} 不支持视觉（capabilities 缺失）；请换一个视觉模型"
        )
        return entry

    caps = [str(item) for item in capabilities]
    # 分支 5b：含 vision → 可用。
    if "vision" in caps:
        entry["available"] = True
        entry["reason"] = f"{model}（{_mask_url(url)}，vision）"
        return entry

    # 分支 5c：明确不含 vision。
    listed = ", ".join(caps) if caps else "空"
    entry["reason"] = (
        f"模型 {model} 不支持视觉（capabilities: {listed}）；请换一个视觉模型"
    )
    return entry


def probe_backends(
    lang: list[str] | str = DEFAULT_LANG,
    python: str | None = None,
    tessdata_dir: str | None = None,
    only: str | None = None,
    ollama_model: str | None = None,
    ollama_url: str | None = None,
) -> list[dict]:
    """探测可用 OCR 后端，返回 `[{"name", "available", "reason"}, ...]`。

    顺序固定为 rapidocr → ollama → tesseract（`auto` 按此优先级取第一个可用者）。
    模块级纯函数、无全局副作用：`bin/eimg-ocr-setup` 通过
    `importlib.util.spec_from_file_location` 复用它做 `--check` 体检。

    `only` 非 None 时只探测该后端。显式 `--backend tesseract` 用得上：全量探测
    会为 rapidocr 起一个解释器跑 `import rapidocr`（连带导入 onnxruntime，慢磁盘上
    可达数百毫秒），而那份结果注定不会被 `resolve_backend` 选中。`only=None`
    （默认）保持全量语义——`--list-backends` 与 `--check` 体检依赖它。

    `ollama_model` / `ollama_url` 是**显式值**（CLI 的 `--ollama-model` /
    `--ollama-url`），为 None 时按配置链回落（config.json → 内置默认 URL）。
    因此调用方可以直接传 None（`bin/eimg-ocr-setup --check` 就是这么做的：它的
    argparse 没有这两个选项）。解析**必须在函数内完成**，不能把入参原样下传给
    `_probe_ollama`——否则 None 会恒落入「未配置模型」分支，config.json 的两个键
    永远失效。
    """

    def probe_rapidocr() -> list[dict]:
        return [_probe_rapidocr(python)]

    def probe_ollama() -> list[dict]:
        resolved_model = _ollama_model(ollama_model)
        raw_url = ollama_url or _config_ollama_url() or DEFAULT_OLLAMA_URL
        try:
            url = _validate_ollama_url(raw_url)
        except EimgError as exc:
            # 地址不合规时**不能**把异常放出去：`--list-backends`、`auto` 与
            # `bin/eimg-ocr-setup --check`（它直接复用本函数）都要求「探测永不
            # raise」，异常会变 traceback 或让「查询后端」变成参数错误。
            # 故折成「不可用 + reason」；CLI 侧「显式 --ollama-url 写错 → 退出码 5」
            # 由 `main` 在探测之前单独校验（见那里的注释）。
            return [
                {
                    "name": "ollama",
                    "available": False,
                    "reason": exc.message,
                    "model": resolved_model,
                    "url": _mask_url(raw_url),
                }
            ]
        return [_probe_ollama(resolved_model, url)]

    def probe_tesseract() -> list[dict]:
        return [_probe_tesseract(lang, tessdata_dir)]

    if only is None:
        return [*probe_rapidocr(), *probe_ollama(), *probe_tesseract()]
    known = {
        "rapidocr": probe_rapidocr,
        "ollama": probe_ollama,
        "tesseract": probe_tesseract,
    }
    if only not in known:
        # 显式后端名由 argparse 的 choices 先拦一遍，这里兜住程序内调用者。
        raise fail(EXIT_NO_BACKEND, f"未知后端: {only}")
    return known[only]()


def format_backend_line(entry: dict) -> str:
    """`--list-backends` 的人读单行格式。"""
    flag = "true" if entry.get("available") else "false"
    return f"{entry.get('name')}: available={flag} reason={entry.get('reason', '')}"


def resolve_backend(requested: str, backends: list[dict]) -> dict:
    """按请求挑后端；挑不到抛退出码 2。"""
    if requested == "auto":
        for entry in backends:
            if entry.get("available"):
                return entry
        details = "；".join(f"{e['name']}: {e['reason']}" for e in backends)
        raise fail(EXIT_NO_BACKEND, f"未找到可用的 OCR 后端（{details}）")

    for entry in backends:
        if entry.get("name") == requested:
            if entry.get("available"):
                return entry
            raise fail(
                EXIT_NO_BACKEND,
                f"未找到可用的 OCR 后端: {requested}（{entry.get('reason', '')}）",
            )
    raise fail(EXIT_NO_BACKEND, f"未找到可用的 OCR 后端: 未知后端 {requested}")


# ─── 输入校验 ────────────────────────────────────────────────────────────────


def validate_inputs(paths: list[str]) -> list[Path]:
    """逐个校验输入文件；任一不合规抛退出码 3。

    三种失败都归到「无法读取输入」：不存在 / 不是普通文件 / 扩展名不支持 /
    无读权限。上游 elisp 侧只按退出码分支提示，不需要区分细类，但 stderr 里
    写清具体原因方便手工排查。
    """
    validated: list[Path] = []
    for raw in paths:
        path = Path(os.path.expanduser(raw))
        if not path.exists():
            raise fail(EXIT_BAD_INPUT, f"无法读取输入: {raw}（文件不存在）")
        if path.is_dir():
            raise fail(EXIT_BAD_INPUT, f"无法读取输入: {raw}（是目录，不是普通文件）")
        if not path.is_file():
            raise fail(EXIT_BAD_INPUT, f"无法读取输入: {raw}（不是普通文件）")
        if path.suffix.lower() not in SUPPORTED_SUFFIXES:
            raise fail(
                EXIT_BAD_INPUT,
                f"无法读取输入: {raw}（不支持的格式 {path.suffix or '无扩展名'}；"
                f"支持: {', '.join(SUPPORTED_SUFFIXES)}）",
            )
        if not os.access(path, os.R_OK):
            raise fail(EXIT_BAD_INPUT, f"无法读取输入: {raw}（无读权限）")
        validated.append(path)
    return validated


# ─── 输出序列化骨架（供后续识别任务复用） ──────────────────────────────────
#
# pages 结构约定（T2b 起所有后端都必须产出这个形状）：
#
#     [
#       {"page": 1,
#        "source": "report.pdf",
#        "blocks": [{"text": "Hello", "conf": 0.98, "box": [x0, y0, x1, y1]},
#                   ...]},
#       ...
#     ]
#
# `page` 是从 1 开始的**真实页码**：图片恒为 1，PDF 取文档里的页号（`--pdf-pages 2`
# → `page == 2`，不是数组下标）；`source` 是输入文件的 basename（多文件输入时用于
# 把页归回文件）；`conf` 为 0–1 的置信度，任何后端拿不到时一律 0.0（不吃 None，
# 让下游不必写 `if conf is None` 分支）；`box` 是像素坐标，无法给出时用 None。


def make_block(text, conf=None, box=None) -> dict:
    """构造一个符合 pages 约定的文本块。"""
    return {"text": "" if text is None else str(text), "conf": conf, "box": box}


def make_page(number: int, blocks=None, source: str | None = None) -> dict:
    """构造一页；`number` 是**真实页码**（PDF 页号 / 图片恒为 1）。"""
    page = {"page": int(number), "blocks": list(blocks or [])}
    if source is not None:
        page["source"] = str(source)
    return page


def sort_blocks_reading_order(blocks: list[dict]) -> list[dict]:
    """把 blocks 排成阅读顺序：先行聚类（按 y 中心 + 行高容差），行内按 x0 升序。

    为什么不能只按 `box[1]`（上沿）排：同一视觉行里的两块高度往往不同——实测
    `test/fixtures/hello.png` 的「世界」y0=136（高 134）、「Hello」y0=148（高 118），
    左块上沿反而更低。只按上沿排会把同一行拆成两行、并把左右顺序排反；只有先按
    **y 中心**聚成行、行内再按 x0 排，才与人的阅读顺序一致。

    容差 `tol = 0.5 * median(所有块高度)`：中位数对个别超大块（整段贴图 / 竖排
    标题）不敏感，比均值稳；固定像素容差则一换 dpi 就失效。

    行的「代表 cy」取该行**首个**块（按 cy 升序扫描时先遇到的那个）的 `cy`，聚类
    期间不再变化：并入后续块不改行代表，避免一串逐渐偏移的块被雪球式并进同一行
    （行代表若随并集漂移，容差窗口会一路跟着走）。

    所有比较都带显式原始下标兜底（`(cy, index)` / `(x0, index)`），任何比较相等
    的元素都保持后端原序。无坐标的块（`box` 缺失 / 长度不足 4 / 无法转 float /
    全为 0）不参与聚类：它们排在**最后**且保持原序、不丢弃；若一页里没有任何带
    坐标的块（某些后端的 `recognize_region` 会给 `[0, 0, 0, 0]`），整页原样返回
    ——没有坐标时任何排序都只是瞎猜。

    与后端无关：rapidocr 与 tesseract 的 blocks 都走这里。排序本身的已知边界
    （多栏排版、竖排文字）见 `openspec/tech-debt.md`。
    """
    items = list(blocks or [])
    if len(items) < 2:
        return items

    # positioned 元素：(原始下标, block, x0, cy, height)
    positioned: list[tuple[int, dict, float, float, float]] = []
    unpositioned: list[dict] = []
    for index, block in enumerate(items):
        box = block.get("box") if isinstance(block, dict) else None
        coords: list[float] | None = None
        if isinstance(box, (list, tuple)) and len(box) >= 4:
            try:
                coords = [float(value) for value in box[:4]]
            except (TypeError, ValueError):
                coords = None
        # 全 0 的框与缺失等价：都定不了序，走同一条退化路径。
        if coords is None or not any(coords):
            unpositioned.append(block)
            continue
        x0, y0, _x1, y1 = coords
        positioned.append((index, block, x0, (y0 + y1) / 2.0, y1 - y0))

    if not positioned:
        return items

    heights = sorted(entry[4] for entry in positioned)
    middle = len(heights) // 2
    if len(heights) % 2:
        median_height = heights[middle]
    else:
        median_height = (heights[middle - 1] + heights[middle]) / 2.0
    tolerance = 0.5 * median_height

    # 按 y 中心升序扫描；cy 相同时按原始下标，保持后端原序。
    ordered = sorted(positioned, key=lambda entry: (entry[3], entry[0]))

    # 贪心聚类：与「当前行的代表 cy = 该行首个块的 cy」相差不超过 tolerance 即
    # 归入当前行，否则开新行。行代表不随并入块更新（见 docstring）。
    rows: list[list[tuple[int, dict, float, float, float]]] = []
    for entry in ordered:
        if rows and abs(entry[3] - rows[-1][0][3]) <= tolerance:
            rows[-1].append(entry)
        else:
            rows.append([entry])

    result: list[dict] = []
    # 行间顺序即聚类产生的顺序（代表 cy 升序）；行内按 x0，等 x0 按原始下标。
    for row in rows:
        for entry in sorted(row, key=lambda item: (item[2], item[0])):
            result.append(entry[1])
    result.extend(unpositioned)
    return result


def page_text(page: dict) -> str:
    """单页纯文本：块之间换行。"""
    return "\n".join(
        block.get("text", "") for block in (page.get("blocks") or [])
    )


def serialize_text(pages: list[dict]) -> str:
    """text 格式：按页输出，页与页之间以 `\\f`（换页符）分隔。

    每页文本以换行收尾、`\\f` 落在**下一行行首**（与 `pdftotext` 的习惯一致）。
    不能直接把 `\\f` 夹在行中间：那样两个换页符可能落在同一行里，按行处理的下游
    （`grep -c`、`while read`、`awk`）会把两页当成一页。
    """
    body = "\f".join(page_text(page) + "\n" for page in pages)
    return body.rstrip("\n")


def serialize_lines(pages: list[dict]) -> str:
    """lines 格式：每行一条文本，页间不加分隔（行序即阅读顺序）。"""
    lines: list[str] = []
    for page in pages:
        for block in page.get("blocks") or []:
            lines.append(block.get("text", ""))
    return "\n".join(lines)


def serialize_json(pages: list[dict], backend: str | None = None) -> str:
    """json 格式：`{"backend": ..., "pages": [...]}`，UTF-8 不转义。

    每页恒带 `source`（输入文件 basename）——多文件输入时下游靠它把页归回文件，
    单文件时保留同一形状，避免下游写「有时有有时没有」的分支。

    `image`（页面对应的图片绝对路径）是**条件性**字段：只有 `--page-images-dir`
    生效时 `pages` 里才会带这个键，此处照实透传、否则不出现。不能恒输出
    `"image": null`——那会让不传参数的旧调用方拿到一份字段集合变了的 JSON，快照
    测试、`==` 对比与严格 schema 都会因此变红，「不传参数时输出不变」是本参数存在
    的前提。
    """
    normalized: list[dict] = []
    for index, page in enumerate(pages):
        # 显式重建而不是复制原 dict：`pages` 里还可能带后端/内部用的临时键（例如
        # recognize_pdf 中间态的字段），只放行契约内的字段才不会被内部实现泄漏出去。
        entry = {
            "page": int(page.get("page", index + 1)),
            "source": page.get("source"),
            "blocks": [
                {
                    "text": block.get("text", ""),
                    "conf": block.get("conf"),
                    "box": block.get("box"),
                }
                for block in (page.get("blocks") or [])
            ],
        }
        # 追加在最后：page / source / blocks 的相对顺序与旧版完全一致，新键只在尾部
        # 出现，按前缀读取的老解析逻辑不受影响。
        if "image" in page:
            entry["image"] = page["image"]
        normalized.append(entry)
    return json.dumps(
        {"backend": backend, "pages": normalized},
        ensure_ascii=False,
        indent=2,
    )


SERIALIZERS = {
    "text": serialize_text,
    "lines": serialize_lines,
}

TYPE_DESCRIPTIONS = {
    "png": "PNG 图片",
    "jpg": "JPEG 图片",
    "jpeg": "JPEG 图片",
    "webp": "WebP 图片",
    "bmp": "BMP 图片",
    "tif": "TIFF 图片",
    "tiff": "TIFF 图片",
    "gif": "GIF 图片",
    "pdf": "PDF 文档",
}


def serialize_pages(pages: list[dict], output_format: str, backend: str | None = None) -> str:
    """按 `--format` 分派到具体序列化函数。"""
    if output_format == "json":
        return serialize_json(pages, backend=backend)
    serializer = SERIALIZERS.get(output_format)
    if serializer is None:  # argparse 的 choices 已拦截，这里是兜底
        raise fail(EXIT_BAD_ARGS, f"参数错误: 未知输出格式 {output_format}")
    return serializer(pages)


# ─── rapidocr 后端（子进程 + 临时文件传结果） ────────────────────────────────

# 为什么是一段内联脚本而不是在本进程里 import：本 CLI 用系统 python3 跑（可能
# 完全没有 rapidocr / numpy / PIL），rapidocr 只装在某个 venv 里。识别必须由
# 「探测到的目标解释器」去执行，故把识别逻辑独立成脚本，用 subprocess 跑它。
#
# 为什么不解析 stdout：rapidocr 会往 stdout 打一排 `[INFO] ... Using engine_name`
# 日志，识别结果与日志混在同一流里，任何「按行找 JSON」的做法都会在换版本 /
# 换日志级别时静默失效。结果改走 argv[2] 指定的文件，父进程读文件再解析。

RAPIDOCR_INLINE_SCRIPT = '''\
"""由 eimg-ocr 生成、在目标解释器里执行的 rapidocr 包装脚本。

用法: python <本脚本> <图片路径> <结果 JSON 路径>

只做三件事：读图 → 识别 → 归一化成 [{"text", "conf", "box"}] 写文件。
不打印识别结果（stdout 留给 rapidocr 自己的日志）。
"""

import json
import sys


def _to_box(points):
    """四点（或多点）包围盒 → [x0, y0, x1, y1]；拿不到有效坐标返回 None。"""
    if points is None:
        return None
    try:
        pairs = [(float(point[0]), float(point[1])) for point in points]
    except (TypeError, ValueError, IndexError):
        return None
    if not pairs:
        return None
    xs = [pair[0] for pair in pairs]
    ys = [pair[1] for pair in pairs]
    return [min(xs), min(ys), max(xs), max(ys)]


def _to_block(points, text, score):
    """归一化单个文本块；空文本返回 None（由调用方丢弃）。"""
    if text is None:
        return None
    # 首尾空白统一去掉：OCR 常在块尾留一个空格（实测 rapidocr 对 "Hello" 返回
    # "Hello "），保留会在按行拼接 / 插入 Emacs 时产出难看的尾随空格。
    text = str(text).strip()
    if not text:
        return None
    try:
        conf = float(score) if score is not None else 0.0
    except (TypeError, ValueError):
        conf = 0.0
    return {"text": text, "conf": conf, "box": _to_box(points)}


def _normalize(out):
    """把 rapidocr 的输出统一成块列表。

    两种形态都要吃：
    1. v3.x：`RapidOCROutput`，带 .boxes / .txts / .scores 三个属性；
    2. 老式：`out` 本身是 list/tuple，每行形如 [points, text, score]。
    判据是「out 是序列且首元素也是序列」——dataclass 不满足这个条件，
    所以两种形态不会互相误判。
    """
    if isinstance(out, (list, tuple)) and out and isinstance(out[0], (list, tuple)):
        rows = []
        for row in out:
            if not isinstance(row, (list, tuple)):
                continue
            rows.append((
                row[0] if len(row) > 0 else None,
                row[1] if len(row) > 1 else None,
                row[2] if len(row) > 2 else None,
            ))
    else:
        boxes = getattr(out, "boxes", None)
        txts = getattr(out, "txts", None)
        scores = getattr(out, "scores", None)
        boxes = list(boxes) if boxes is not None else []
        txts = list(txts) if txts is not None else []
        scores = list(scores) if scores is not None else []
        rows = [
            (
                boxes[index] if index < len(boxes) else None,
                txts[index] if index < len(txts) else None,
                scores[index] if index < len(scores) else None,
            )
            for index in range(max(len(boxes), len(txts)))
        ]
    return [block for block in (_to_block(*row) for row in rows) if block]


def main():
    image_path, result_path = sys.argv[1], sys.argv[2]

    import numpy as np
    from PIL import Image
    from rapidocr import RapidOCR

    engine = RapidOCR()
    # 统一转 RGB 再交给引擎：灰度 / RGBA / 调色板图在各后端行为不一致；
    # ascontiguousarray 保证 onnxruntime 拿到连续内存（否则可能报 stride 错）。
    pixels = np.ascontiguousarray(np.asarray(Image.open(image_path).convert("RGB")))
    out = engine(pixels, use_det=True, use_cls=True, use_rec=True)
    with open(result_path, "w", encoding="utf-8") as handle:
        json.dump(_normalize(out), handle, ensure_ascii=False)
        handle.write("\\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
'''


def _last_line(text: str) -> str:
    """取文本最后一个非空行，用于把子进程报错压缩成一行。"""
    for line in reversed((text or "").strip().splitlines()):
        if line.strip():
            return line.strip()
    return ""


def _stderr_tail(text: str, limit: int = 3) -> str:
    """取 stderr 末 `limit` 行非空内容，用 ` | ` 拼成一行（失败时报错用）。

    tesseract 的报错常在倒数几行（前面是进度日志），只取最后一行会把
    `Error in pixReadMem...` 这类关键行切掉，故保留 3 行。
    """
    lines = [line.strip() for line in (text or "").strip().splitlines() if line.strip()]
    return " | ".join(lines[-limit:]) if lines else ""


def run_rapidocr(
    image_path: Path, python_exe: str, lang_timeout: int = RAPIDOCR_TIMEOUT
) -> list[dict]:
    """用目标解释器跑 rapidocr 识别一张图，返回 blocks 列表。

    临时脚本与结果文件都放在同一个 `mkdtemp` 目录里，`finally` 统一删除——
    成功与失败两条路径都不留半成品。超时按退出码 4 处理（stderr 含「识别失败」
    与「rapidocr 超时」），不无限挂起。

    `lang_timeout` 是子进程超时秒数（参数名沿用 openspec 计划，与 `--lang`
    无关，rapidocr 也没有语言超时这个概念）。
    """
    if not python_exe:
        raise fail(EXIT_OCR_FAILED, f"识别失败: {image_path}（rapidocr 解释器未知）")

    workdir = tempfile.mkdtemp(prefix=TEMP_PREFIX)
    try:
        script_path = Path(workdir) / "rapidocr_recognize.py"
        script_path.write_text(RAPIDOCR_INLINE_SCRIPT, encoding="utf-8")
        handle, result_name = tempfile.mkstemp(
            prefix="result-", suffix=".json", dir=workdir
        )
        os.close(handle)
        result_path = Path(result_name)

        try:
            # errors="replace"：同 `run_tesseract`——后端报错会把图像里的原始
            # 字节带进 stderr，纯 `text=True' 解码失败会穿透成 traceback。
            proc = subprocess.run(
                [python_exe, str(script_path), str(image_path), str(result_path)],
                capture_output=True,
                text=True,
                errors="replace",
                timeout=lang_timeout,
            )
        except subprocess.TimeoutExpired:
            raise fail(
                EXIT_OCR_FAILED,
                f"识别失败: {image_path}（rapidocr 超时: 超过 {lang_timeout} 秒未完成）",
            )
        except OSError as exc:
            raise fail(
                EXIT_OCR_FAILED,
                f"识别失败: {image_path}（无法执行 rapidocr 解释器 {python_exe}: "
                f"{exc.strerror or exc}）",
            )

        if proc.returncode != 0:
            detail = _last_line(proc.stderr)
            suffix = f": {detail}" if detail else ""
            raise fail(
                EXIT_OCR_FAILED,
                f"识别失败: {image_path}（rapidocr 退出码 {proc.returncode}{suffix}）",
            )

        try:
            raw = result_path.read_text(encoding="utf-8")
        except OSError as exc:
            raise fail(
                EXIT_OCR_FAILED,
                f"识别失败: {image_path}（读不到 rapidocr 结果文件: "
                f"{exc.strerror or exc}）",
            )
        try:
            data = json.loads(raw)
        except ValueError as exc:
            raise fail(
                EXIT_OCR_FAILED,
                f"识别失败: {image_path}（rapidocr 结果不是合法 JSON: {exc}）",
            )
        if not isinstance(data, list):
            raise fail(
                EXIT_OCR_FAILED, f"识别失败: {image_path}（rapidocr 结果不是块列表）"
            )

        blocks: list[dict] = []
        for item in data:
            if not isinstance(item, dict):
                continue
            blocks.append(
                make_block(item.get("text"), item.get("conf"), item.get("box"))
            )
        return blocks
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


# ─── tesseract 后端（一次调用出 TSV，所有格式同源派生） ──────────────────────

# 为什么是 `-c tessedit_create_tsv=1` 而不是把配置名 `tsv` 放在命令行最后：
# 两种写法在**默认** tessdata 目录（/usr/share/tessdata，内含 configs/tsv 与
# tessconfigs/tsv）下都work，但一旦传了 `--tessdata-dir`，tesseract 只在该目录
# 里找配置文件——`tesseract img stdout -l afr --tessdata-dir /tmp/d tsv` 会打印
# `read_params_file: Can't open tsv` 然后**静默退化成纯文本输出且退出码仍为 0**
# （实测 tesseract 5.5.3）。这种「rc=0 但格式不对」的失败最难排查，故一律用
# `-c` 直接设参数，它不经过配置文件查找，两种情形行为一致。
#
# 实测正确的参数顺序（选项可任意插在位置参数之间，位置参数顺序固定为
# `<image> <outputbase> [configfile...]`）：
#
#     tesseract <image> stdout -l <langs> [--tessdata-dir <dir>] -c tessedit_create_tsv=1
#
# `stdout` 作为 outputbase 让结果走标准输出，不落任何临时文件（stderr 归日志）。

# TSV 列序（tesseract 5.x）：
#   level page_num block_num par_num line_num word_num left top width height conf text
# level 取值：1 page / 2 block / 3 paragraph / 4 line / 5 word；只有 5 带真实文本。
TSV_WORD_LEVEL = 5


def _parse_tesseract_tsv(text: str) -> list[dict]:
    """把 tesseract TSV 输出聚合成 blocks（一个文本行一个块）。

    分组键是 `(page_num, block_num, par_num, line_num)`——直接按 level==4 的行
    （line）取文本是不行的，level 4 行的 text 列恒为空。故取 level==5 的词行按
    行号聚合：词之间用单空格连接，`box` 取该行词的并集，`conf` 取词 conf 均值。

    `conf` 归一化到 0–1（除以 100）与 rapidocr 的语义对齐，下游不必按后端分支；
    conf 为 -1 的词（tesseract 对拿不到置信度的词给 -1）不计入均值，整行都是
    -1 时 conf 取 0.0——与 rapidocr 侧「拿不到就给 0.0」保持一致，不吃 None，
    免得下游每处都得先判 `conf is None`。
    """
    groups: dict[tuple[int, int, int, int], dict] = {}
    # split("\t", 11) 让第 12 列（text）保留列内可能出现的制表符，不被切碎。
    for row in (text or "").splitlines():
        fields = row.split("\t", 11)
        if len(fields) < 12:
            continue
        try:
            if int(fields[0]) != TSV_WORD_LEVEL:
                continue
            page_num, block_num, par_num, line_num = (
                int(fields[1]),
                int(fields[2]),
                int(fields[3]),
                int(fields[4]),
            )
            left, top, width, height = (
                int(fields[6]),
                int(fields[7]),
                int(fields[8]),
                int(fields[9]),
            )
            conf = float(fields[10])
        except ValueError:
            # 表头行（level 是字面量 "level"）与任何畸形行都直接跳过：
            # 坏一行不该让整张图识别失败。
            continue

        word = fields[11].strip()
        if not word:
            continue

        key = (page_num, block_num, par_num, line_num)
        group = groups.get(key)
        if group is None:
            group = {"words": [], "lefts": [], "tops": [], "rights": [], "bottoms": [], "confs": []}
            groups[key] = group
        group["words"].append(word)
        group["lefts"].append(left)
        group["tops"].append(top)
        group["rights"].append(left + width)
        group["bottoms"].append(top + height)
        if conf >= 0:
            group["confs"].append(conf)

    blocks: list[dict] = []
    for group in groups.values():
        line_text = " ".join(group["words"]).strip()
        if not line_text:
            continue
        box = [
            min(group["lefts"]),
            min(group["tops"]),
            max(group["rights"]),
            max(group["bottoms"]),
        ]
        confs = group["confs"]
        # 整行词 conf 全为 -1（tesseract 拿不到置信度）时给 0.0 而不是 None：
        # rapidocr 侧同样以 0.0 兜底，两侧一致下游才不必分支。
        line_conf = round(sum(confs) / len(confs) / 100.0, 4) if confs else 0.0
        blocks.append(make_block(line_text, line_conf, box))
    return blocks


def run_tesseract(
    image_path: Path,
    lang: list[str] | str,
    tessdata_dir: str | None = None,
    timeout: int = TESSERACT_TIMEOUT,
) -> list[dict]:
    """用 tesseract 识别一张图，返回 blocks 列表（每行一个块）。

    `lang` 接受 `parse_lang` 的列表或 `chi_sim+eng` 形式的串，原样拼回 `+` 交给
    `-l`（tesseract 自己的多语言语法）。`tessdata_dir` 非空时透传 `--tessdata-dir`，
    供 `bin/eimg-ocr-setup` 装到自定义目录后使用；为空时自动落到 eimg 安装目录
    （`resolve_tessdata_dir`），与探测阶段用的是同一条规则——否则会出现「探测说
    可用、识别时又找不到语言数据」。

    失败一律退出码 4：超时文案含「tesseract 超时」，非零退出码文案含 stderr 末 3 行。
    成功时 stderr（`Estimating resolution as ...` 等日志）直接丢弃——它只是噪声，
    混进输出会把 text 格式弄脏。
    """
    executable = shutil.which("tesseract")
    if not executable:
        raise fail(
            EXIT_OCR_FAILED, f"识别失败: {image_path}（未在 PATH 上找到 tesseract）"
        )

    effective_dir, _ = resolve_tessdata_dir(tessdata_dir)
    wanted = parse_lang(lang) if isinstance(lang, str) else [str(item) for item in lang]
    command = [executable, str(image_path), "stdout", "-l", "+".join(wanted)]
    if effective_dir:
        command.extend(["--tessdata-dir", str(effective_dir)])
    command.extend(["-c", "tessedit_create_tsv=1"])

    try:
        # errors="replace"：leptonica 的报错会把图像里的原始字节直接写进 stderr
        # （坏图 / 特殊 TIFF 元数据实测出现过 0xa1），默认严格 UTF-8 解码会在
        # `subprocess.run` 内部抛 UnicodeDecodeError，让「识别失败」变成 traceback。
        proc = subprocess.run(
            command, capture_output=True, text=True, errors="replace", timeout=timeout
        )
    except subprocess.TimeoutExpired:
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {image_path}（tesseract 超时: 超过 {timeout} 秒未完成）",
        )
    except OSError as exc:
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {image_path}（无法执行 tesseract {executable}: "
            f"{exc.strerror or exc}）",
        )

    if proc.returncode != 0:
        detail = _stderr_tail(proc.stderr, 3)
        suffix = f": {detail}" if detail else ""
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {image_path}（tesseract 退出码 {proc.returncode}{suffix}）",
        )

    # 图片是一页，TSV 里 page_num 恒为 1，故块列表直接对应单页。
    return _parse_tesseract_tsv(proc.stdout)


# ─── ollama 后端（本地 HTTP + VLM，逐行成块） ────────────────────────────────

# 代码围栏首行：三个反引号，可带语言名（```text / ```python），但**不能有空格**——
# 带空格的是正文（比如用反引号写的 Markdown 说明），不能当围栏剥掉。
_FENCE_FIRST = re.compile(r"^```[\w.+\-]*$")


def _strip_code_fence(text: str) -> str:
    """整段被 ``` 围栏包裹时去掉首末两行。

    VLM 常把答案塞进 Markdown 代码块（提示词已明确禁止，但不能只靠它）。判据收紧
    到「首行是纯围栏标记 + 末行是三反引号」，避免把正文里恰好以 ``` 开头的行当围栏。
    """
    lines = text.splitlines()
    if len(lines) < 2:
        return text
    if _FENCE_FIRST.match(lines[0].strip()) and lines[-1].strip() == "```":
        return "\n".join(lines[1:-1])
    return text


def run_ollama(
    image_path: Path,
    model: str | None,
    url: str | None,
    timeout: int = OLLAMA_TIMEOUT,
) -> list[dict]:
    """用 ollama 的视觉模型识别一张图，返回 blocks 列表（每行一块，全部无 box）。

    走 `/api/chat`（而不是 `/api/generate`）：只有 chat 接口有 `messages[].images`
    这个放图片的槽位，`stream: false` 关掉流式（否则要处理 NDJSON 分块），
    `options.temperature: 0` 换取可复现的逐字输出，`keep_alive: "5m"` 让模型在多页
    PDF 的连续调用之间驻留——否则每页都要重新加载权重。

    **拿不到置信度与坐标**：VLM 只回文本，故 `conf` 恒 0.0（不吃 None，下游不必写
    `if conf is None`）、`box` 恒 None。顺序即模型给的顺序（`sort_blocks_reading_order`
    对无坐标块整页原样返回），不做任何二次猜测。

    `model` / `url` 由调用方从探测 entry 取（`backend["model"]` / `backend["url"]`）。
    失败一律退出码 4，且**清理后没有任何行也算失败**——返回空列表会让 `main` 报
    「未产出任何文本页」，那对 VLM 场景太含糊（图片里确实没字，也该说清是哪一步空的）。
    """
    if not model:
        raise fail(EXIT_OCR_FAILED, f"识别失败: {image_path}（未配置 ollama 模型）")
    target = url or DEFAULT_OLLAMA_URL

    # 大小检查放在 `read_bytes` **之前**：一张 1 GB 的图读进内存再 base64（再多 4/3）
    # 足以把本进程的常驻内存推到 OOM，而 OOM 是不带退出码契约的崩溃。stat 只读
    # inode，代价可忽略；超限按「输入不可读」（3）报，与其它「这个文件不能当输入」
    # 的失败一致。
    try:
        total_bytes = image_path.stat().st_size
    except OSError as exc:
        raise fail(
            EXIT_BAD_INPUT, f"无法读取输入: {image_path}（{exc.strerror or exc}）"
        )
    if total_bytes > OLLAMA_MAX_IMAGE:
        raise fail(
            EXIT_BAD_INPUT,
            f"无法读取输入: {image_path}"
            f"（文件过大，ollama 后端上限 {OLLAMA_MAX_IMAGE // (1024 * 1024)} MB）",
        )

    try:
        raw_bytes = image_path.read_bytes()
    except OSError as exc:
        raise fail(
            EXIT_BAD_INPUT,
            f"无法读取输入: {image_path}（{exc.strerror or exc}）",
        )

    body = {
        "model": model,
        "messages": [
            {
                "role": "user",
                "content": OLLAMA_PROMPT,
                "images": [base64.b64encode(raw_bytes).decode("ascii")],
            }
        ],
        "stream": False,
        "options": {"temperature": 0},
        "keep_alive": "5m",
    }

    try:
        status, text = _ollama_http(f"{target}/api/chat", body, timeout)
    except _OllamaRedirect as exc:
        # 识别侧的重定向就是识别失败（4）：跟过去等于把整张图发到 Location 指向的主机。
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {image_path}"
            f"（ollama 服务返回重定向（HTTP {exc.code}），已拒绝跟随）",
        )
    except _OllamaResponseTooLarge as exc:
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {image_path}"
            f"（ollama 响应体过大（{exc.size} 字节，上限 {exc.limit}））",
        )
    except _OllamaDeadlineExceeded as exc:
        # 整体预算耗尽。**必须显式捕获**：`main` 只 catch `EimgError` /
        # `KeyboardInterrupt` / `SubprocessError`，本异常穿透就是一条 traceback。
        # 与下面的「单次操作超时」分开报：这条是「服务通但慢」，慢速滴流响应下
        # 单次 socket 超时永远不会触发，只有整体预算能在这里终止它。
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {image_path}"
            f"（ollama 整体超时：上限 {exc.timeout} 秒）",
        )
    except (urllib.error.URLError, OSError, http.client.HTTPException) as exc:
        detail = _ollama_error_text(exc)
        if _ollama_timed_out(exc):
            raise fail(
                EXIT_OCR_FAILED,
                f"识别失败: {image_path}（ollama 超时: 超过 {timeout} 秒未完成）",
            )
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {image_path}"
            f"（无法连接 ollama 服务 {_mask_url(target)}: {detail}）",
        )

    if status != 200:
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {image_path}（ollama 退出码 HTTP {status}: {text[:200]}）",
        )

    try:
        data = json.loads(text)
    except (ValueError, TypeError) as exc:
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {image_path}（ollama 响应不是合法 JSON: {exc}）",
        )

    content = None
    if isinstance(data, dict):
        message = data.get("message")
        if isinstance(message, dict):
            content = message.get("content")
    if not isinstance(content, str):
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {image_path}（ollama 响应缺少 message.content）",
        )

    # 清理顺序固定：strip → 剥围栏 → 逐行 strip 并丢空行 → 每行一块。
    lines = [line.strip() for line in _strip_code_fence(content.strip()).splitlines()]
    blocks = [make_block(line, 0.0, None) for line in lines if line]
    if not blocks:
        raise fail(
            EXIT_OCR_FAILED, f"识别失败: {image_path}（ollama 未识别出任何文字）"
        )
    return blocks


# ─── PDF 栅格化（pdftoppm） ──────────────────────────────────────────────────


def natural_sort_key(name: str) -> list:
    """自然排序键：把数字段按数值比较。

    必须用自然排序而不是字典序——pdftoppm 的输出名把页号**零填充**到与总页数
    相同的位数（12 页文档 → `page-01.png` … `page-12.png`），字典序会把
    `page-10.png` 排在 `page-2.png` 前面，识别结果的页序直接错乱。
    """
    return [
        int(part) if part.isdigit() else part.lower()
        for part in re.split(r"(\d+)", name)
    ]


def image_page_number(path: Path) -> int | None:
    """从 pdftoppm 输出文件名取页号（`page-07.png` → 7），取不到返回 None。

    输出名固定是 `<prefix>-<页号>.png`，但**零填充位数随总页数变化**（3 页 →
    `page-1.png`；12 页 → `page-01.png`），所以不能硬编码位数。也不能用
    「首个文件 = 起始页 + 下标」推算：请求 `-f 2 -l 5` 打在 3 页文档上时，
    pdftoppm 只输出 2、3 两页（rc 仍为 0），下标推算会给出 2、3 之外的错页号。
    取文件名里最后一个数字段，两种情况都准确。
    """
    numbers = re.findall(r"\d+", path.name)
    return int(numbers[-1]) if numbers else None


def pdf_page_count(path: Path) -> int | None:
    """用 `pdfinfo` 取 PDF 真实页数；pdfinfo 缺失 / 失败 / 输出不可解析时返回 None。

    页数只用于把「页码越界」的报错说清楚（「页码 9 超出范围（共 3 页）」），
    拿不到就不该阻断识别——返回 None，由 pdftoppm 的越界信号兜底判定。
    """
    executable = shutil.which("pdfinfo")
    if not executable:
        return None
    try:
        proc = subprocess.run(
            [executable, str(path)],
            capture_output=True,
            text=True,
            errors="replace",
            timeout=PDFINFO_TIMEOUT,
        )
    except (subprocess.TimeoutExpired, OSError):
        return None
    if proc.returncode != 0:
        # 损坏 / 加密的 PDF 在这里就走不通，让 pdftoppm 去给出更具体的报错。
        return None
    for line in (proc.stdout or "").splitlines():
        key, _, value = line.partition(":")
        if key.strip().lower() == "pages":
            try:
                return int(value.strip())
            except ValueError:
                return None
    return None


def _pdf_overflow_message(
    path: Path,
    requested: list[int],
    total: int | None,
    first_overflow: int | None = None,
) -> str:
    """页码越界的统一文案（退出码 3，含「无法读取输入」与「超出范围」）。

    `first_overflow` 是**最小的越界页号**（3 页文档请求 `2-9` → 4）。不能用
    `min(requested)`：那会报成「页码 2 超出范围」，而 2 明明是有效页，
    用户按提示改参数会越改越糊涂。pdftoppm 报越界（rc 99）时手头没有具体
    越界页，才退回 `min(requested)`——那种情形下它确实已经越界。
    """
    span = (
        f"{requested[0]}-{requested[-1]}" if len(requested) > 1 else str(requested[0])
    )
    first = first_overflow if first_overflow is not None else min(requested)
    if total is not None:
        return (
            f"无法读取输入: {path}（页码 {first} 超出范围（共 {total} 页），"
            f"请求 {span}）"
        )
    return (
        f"无法读取输入: {path}（页码 {span} 超出范围，"
        f"PDF 无对应页；可用 pdfinfo 查看总页数）"
    )


def rasterize_pdf(
    path: Path,
    dpi: int,
    pages: list[int] | None,
    workdir: str,
    total: int | None = None,
) -> list[tuple[int, Path]]:
    """把 PDF 选中页栅格化成 PNG，返回 `[(真实页码, 图片路径), ...]`（页码升序）。

    `pages` 为 None 表示整本。多页一次调用 `-f/-l` 渲完：每页起一次 pdftoppm
    会把整本的 xref 重复解析 N 遍，10 页文档实测慢 5 倍以上。

    三类失败分开报：
    - 起始页超过文档末页（pdftoppm 退出码 99）→ 退出码 3，页码越界文案；
    - 渲染零输出（无 pdfinfo 时唯一的越界判据）→ 同上；
    - 其它非零退出码（文件损坏 / 加密）→ 退出码 3，带 stderr 末两行。
    """
    executable = shutil.which("pdftoppm")
    if not executable:
        raise fail(
            EXIT_BAD_INPUT,
            f"无法读取输入: {path}（未在 PATH 上找到 pdftoppm，无法栅格化 PDF）",
        )

    prefix = Path(workdir) / "page"
    command = [executable, "-r", str(dpi), "-png"]
    if pages:
        command.extend(["-f", str(pages[0]), "-l", str(pages[-1])])
    command.extend([str(path), str(prefix)])

    try:
        proc = subprocess.run(
            command,
            capture_output=True,
            text=True,
            errors="replace",
            timeout=PDF_RASTER_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {path}（pdftoppm 超时: 超过 {PDF_RASTER_TIMEOUT} 秒未完成）",
        )
    except OSError as exc:
        raise fail(
            EXIT_BAD_INPUT,
            f"无法读取输入: {path}（无法执行 pdftoppm {executable}: "
            f"{exc.strerror or exc}）",
        )

    if proc.returncode == PDFTOPPPM_PAGE_RANGE_ERROR and pages:
        raise fail(EXIT_BAD_INPUT, _pdf_overflow_message(path, pages, total))
    if proc.returncode != 0:
        detail = _stderr_tail(proc.stderr, 2)
        suffix = f": {detail}" if detail else ""
        raise fail(
            EXIT_BAD_INPUT,
            f"无法读取输入: {path}（pdftoppm 退出码 {proc.returncode}{suffix}）",
        )

    produced = sorted(
        Path(workdir).glob("page*.png"), key=lambda item: natural_sort_key(item.name)
    )
    if not produced:
        if pages:
            raise fail(EXIT_BAD_INPUT, _pdf_overflow_message(path, pages, total))
        raise fail(EXIT_BAD_INPUT, f"无法读取输入: {path}（PDF 未渲染出任何页面）")

    rasterized: list[tuple[int, Path]] = []
    for index, image in enumerate(produced):
        number = image_page_number(image)
        if number is None:  # pdftoppm 命名固定，理论不会走到；兜底按起始页 + 下标
            number = (pages[0] if pages else 1) + index
        rasterized.append((number, image))
    return rasterized


# ─── 识别入口 ────────────────────────────────────────────────────────────────


def _prepare_page_images_dir(explicit: str | None) -> Path | None:
    """把 `--page-images-dir` 的取值变成一个可写的目录；未给出则返回 None。

    目录不存在时**自动创建**（`parents=True, exist_ok=True`）：调用方（elisp 侧）传的
    通常是临时目录，让每个调用点自己先 mkdir 只会把「先有鸡还是先有蛋」复制到各处。

    失败一律按**参数错误**（退出码 5）报，而不是输入错误（3）：目录路径是命令行上敲
    进来的参数，建不出来 / 不可写说明参数本身不可用，与「输入文件读不出来」是两类
    问题，混成一个码会让上游分不清该改命令行还是该改文件。
    必须在 `main()` 的 `try` 内调用——`fail()` 抛的是 `EimgError`，掉到 `try` 外就是
    裸 traceback + 退出码 1，那正是退出码契约里不允许出现的形态。
    """
    if explicit is None:
        return None

    target = Path(explicit).expanduser()
    # 先判类型再 mkdir：`mkdir(exist_ok=True)` 撞上「同名普通文件」时抛的是
    # FileExistsError（文案「File exists」），用户看不出到底哪不对；提前给出
    # 「已存在但不是目录」比让他自己猜强。
    if target.exists() and not target.is_dir():
        raise fail(
            EXIT_BAD_ARGS,
            f"参数错误: --page-images-dir {explicit}（已存在但不是目录）",
        )
    try:
        target.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        raise fail(
            EXIT_BAD_ARGS,
            f"参数错误: --page-images-dir {explicit}（无法创建目录: "
            f"{exc.strerror or exc}）",
        )
    # 显式探一次可写性：否则要等栅格化完、识别完才在 `shutil.copy2` 处失败，用户白等
    # 十几秒才看到「参数错误」。
    if not os.access(target, os.W_OK | os.X_OK):
        raise fail(
            EXIT_BAD_ARGS,
            f"参数错误: --page-images-dir {explicit}（目录不可写）",
        )
    return target


def _copy_page_image(
    image: Path,
    source: Path,
    number: int,
    destination: Path,
) -> Path:
    """把栅格化出的单页 PNG 复制进 `destination`，返回其**绝对**路径。

    为什么必须复制、不能把栅格化临时目录里的路径直接给下游：那个目录在
    `recognize_pdf` 的 `finally` 里无条件删除（防止失败路径漏删把 /tmp 撑爆），
    直接引用等于给下游一个「命令一退出就失效」的路径。

    命名取 `<源文件名主干>-p<真实页码>.png`：页码用 PDF 里的真实页号而非数组下标，
    与 `pages[i]["page"]` 同一口径——`--pdf-pages 3` 时落地文件必须是 `x-p3.png`
    而不是 `x-p1.png`，否则下游按页号找图会整体偏移。

    写不进去按「识别失败」（退出码 4）报：参数目录已在校验阶段确认可写，此刻失败
    属于运行期 IO 故障（磁盘满 / 权限中途变化），与「参数敲错」无关。
    """
    target = destination / f"{source.stem}-p{number}.png"
    try:
        shutil.copy2(image, target)
    except OSError as exc:
        raise fail(
            EXIT_OCR_FAILED,
            f"识别失败: {source}（无法写出页面图片 {target}: {exc.strerror or exc}）",
        )
    # resolve() 而不是 str(target)：契约是「绝对路径」（下游要把它当独立文件名用，
    # 不能依赖当时的 cwd）。用户传相对 DIR 时 str(target) 仍带相对成分，resolve()
    # 才把它钉成绝对路径并消掉 `..` / 符号链接歧义。
    return target.resolve()


def recognize_image(path: Path, backend: dict, args) -> list[dict]:
    """识别单张图片，返回 blocks 列表（不含页码包装，**已按阅读顺序排好**）。"""
    kind = TYPE_DESCRIPTIONS.get(path.suffix.lower().lstrip("."), "文件")
    name = backend.get("name")

    if name == "rapidocr":
        # rapidocr 可用时 reason 就是「能 import rapidocr 的解释器路径」：探测阶段
        # 已确认它存在且可执行，这里直接拿来起子进程。
        blocks = run_rapidocr(path, backend.get("reason") or "")
    elif name == "tesseract":
        blocks = run_tesseract(
            path,
            args.lang,
            tessdata_dir=getattr(args, "tessdata_dir", None),
        )
    elif name == "ollama":
        # D-E：扩展名白名单。CLI 无 PIL 无法转码，而 ollama 对 tiff / gif / webp 的
        # 解码支持不确定（未实测）；明确拒绝优于静默失败。PDF 栅格化产物恒为 png，
        # 故 PDF 路径不受影响。
        if path.suffix.lower() not in OLLAMA_SUFFIXES:
            raise fail(
                EXIT_BAD_INPUT,
                f"无法读取输入: {path}（ollama 后端只支持 png/jpg/jpeg；"
                "tiff/gif/webp 请用 rapidocr 或 tesseract）",
            )
        # 模型与 URL **一律取探测 entry 的字段**，不从 args 重新解析：`auto` 选中
        # ollama 时 `args.ollama_model` 可能是 None（值来自 config.json）。
        blocks = run_ollama(path, backend.get("model"), backend.get("url"))
    else:
        raise fail(EXIT_OCR_FAILED, f"识别失败: {path}（{kind}；未知后端 {name}）")

    # 后端的输出顺序是模型自己的顺序、不是阅读顺序（实测 rapidocr 对 hello.png
    # 把右边的「世界」排在了「Hello」前面），统一在这里归一。
    return sort_blocks_reading_order(blocks)


def recognize_pdf(path: Path, backend: dict, args) -> list[dict]:
    """PDF：栅格化后**逐页**识别，返回 pages（`page` 是 PDF 里的真实页码）。

    逐页而不是整本一次：tesseract / rapidocr 都是单图接口，整本传不进去；也正因为
    每页单独调用，多页 TSV 天然按页分组（一次传整本时 TSV 的 page_num 会混在
    同一份输出里，还得再拆）。

    临时目录在 `finally` 里删：成功、后端报错、超时、Ctrl-C 四条路径都要清。

    已知边界：拿不到 pdfinfo（未安装）时无法判断「请求区间部分越界」，此时
    pdftoppm 自身会把区间截断到最后一页（`-f 2 -l 9` 打在 3 页文档上只输出
    2、3 两页且 rc=0），我们照实返回识别到的页，不报错——没有总页数就没有
    判据，「少了几页」这件事只能靠下游对页数自检。
    """
    requested = getattr(args, "pdf_pages", None)
    dpi = getattr(args, "dpi", DEFAULT_DPI)

    total = pdf_page_count(path)
    if total is not None:
        if total <= 0:
            raise fail(EXIT_BAD_INPUT, f"无法读取输入: {path}（PDF 页数为 0）")
        if requested:
            overflow = [page for page in requested if page > total]
            if overflow:
                raise fail(
                    EXIT_BAD_INPUT,
                    _pdf_overflow_message(path, requested, total, min(overflow)),
                )

    workdir = tempfile.mkdtemp(prefix=TEMP_PREFIX)
    destination = getattr(args, "page_images_dir_path", None)
    try:
        rasterized = rasterize_pdf(path, dpi, requested, workdir, total)
        # 逐页构造（而非列表推导）：给了 `--page-images-dir` 时每页还要多一个 `image`
        # 键，推导式里塞条件分支会比循环更难读。
        pages: list[dict] = []
        for number, image in rasterized:
            page = make_page(
                number,
                # 图片路径已在 `recognize_image` 内排过序；这里再对每页显式排一次是
                # 幂等兜底（同一份 block 集合必然收敛到同一顺序），让 PDF 路径的顺序
                # 不依赖「recognize_image 内部做了什么」这一实现细节。
                sort_blocks_reading_order(recognize_image(image, backend, args)),
            )
            if destination is not None:
                page["image"] = str(
                    _copy_page_image(image, path, number, destination)
                )
            pages.append(page)
    finally:
        # 一份 200 dpi 的 A4 页解出来是几百 KB，失败路径漏删会在 /tmp 长期堆积。
        shutil.rmtree(workdir, ignore_errors=True)
    return pages


def recognize_file(path: Path, backend: dict, args) -> list[dict]:
    """识别单个文件，返回 pages 结构（`source` 由调用方回填）。

    分流：PDF 走 pdftoppm 栅格化 + 逐页识别；图片按扩展名之外一视同仁，作为
    1 页（`page` 恒为 1）交给后端。

    `--lang` 只对 tesseract 生效（原样拼成 `+` 串交给 `-l`）；rapidocr 的模型
    固定中英文，忽略该参数但不报错——这一差异已在 `--help` 里注明。
    `--dpi` / `--pdf-pages` 只影响 PDF 路径，对图片输入无意义（忽略而不报错，
    免得「同一批混排文件」因其中一个参数而整批失败）。
    `--page-images-dir` 对两类输入都生效，但含义不同：PDF 是「每页栅格化图落到该
    目录」，图片是「直接指向输入图本身」（见下方注释）。
    """
    if path.suffix.lower() == ".pdf":
        return recognize_pdf(path, backend, args)

    page = make_page(1, recognize_image(path, backend, args))
    if getattr(args, "page_images_dir_path", None) is not None:
        # 图片输入没有栅格化产物，`--page-images-dir` 在这里的语义只剩「告诉我这页来自
        # 哪张原图」：直接给输入图路径，不复制——原图本来就一直在，复制只会多出一份会
        # 与源文件悄悄漂移的副本。
        # resolve() 让相对路径输入（`eimg-ocr x.png`）也给出绝对路径，下游不必再拼 cwd。
        page["image"] = str(path.resolve())
    return [page]


# ─── 主流程 ──────────────────────────────────────────────────────────────────


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    # 参数校验优先于任何查询/识别动作：`--list-backends --backend bogus`
    # 这类组合里，错的是参数，不该因为「查询不需要后端」就放过。
    # （choices 已在 parse_args 内拦掉取值错误，这里是「缺位置参数」的补充校验。）
    if not args.list_backends and not args.files:
        parser.error("至少需要一个 FILE（或用 --list-backends 只查后端）")

    # 显式给出的 ollama 地址先校验一次：`--ollama-url ftp://…` 是**参数错误**
    # （退出码 5），不能等到探测阶段被折成「后端不可用」（那是 2，会让人以为问题
    # 在服务端而不是自己敲的地址）。config.json 里的地址不在这里拦——那是配置
    # 问题，折成「ollama 不可用」比让整条命令（含 rapidocr / tesseract）失败更合适，
    # 见 `probe_backends`。
    # 校验放在 `try` 内部：它抛的是 `EimgError`（退出码 5），掉到 `try` 之外就是
    # 一个裸 traceback（退出码 1），那正好是退出码契约里不允许出现的形态。
    try:
        if args.ollama_url:
            _validate_ollama_url(args.ollama_url)
        # `--page-images-dir` 与 ollama 地址同属「敲进来的参数」：目录建不出来 / 不可写
        # 就是参数错误（退出码 5），不该等到识别完才在 copy 处炸，也不该被折成 4。
        # 校验同样放在 `try` 内（理由见上）。解析结果挂回 args 而不是层层传参：识别函数
        # 已经统一从 args 取 `dpi` / `pdf_pages`，加一个字段比改三条函数签名影响面小。
        # 这里对 `--list-backends` 也照常校验——参数错误优先于查询动作，与上面的地址
        # 校验保持同一口径；代价是纯查询时会顺手建一个空目录，这是用户显式请求的副作用。
        args.page_images_dir_path = _prepare_page_images_dir(args.page_images_dir)
        if args.list_backends:
            # --list-backends 是**查询**动作而非识别任务：即便所有后端都不可用，
            # 命令本身也成功完成了「告诉你哪个后端可用、为什么不可用」这件事，
            # 故退出码为 0。否则调用方无法区分「查询失败」与「后端全缺」，
            # 也拿不到已经打印出来的 reason。
            backends = probe_backends(
                lang=args.lang,
                python=args.python,
                tessdata_dir=args.tessdata_dir,
                ollama_model=args.ollama_model,
                ollama_url=args.ollama_url,
            )
            for entry in backends:
                print(format_backend_line(entry))
            return EXIT_OK

        inputs = validate_inputs(args.files)
        # 显式指定后端时只探测它（理由见 `probe_backends' 的 `only' 参数）；
        # `auto` 仍全量探测，上面 `--list-backends' 那条分支同样保持全量。
        backends = probe_backends(
            lang=args.lang,
            python=args.python,
            tessdata_dir=args.tessdata_dir,
            only=None if args.backend == "auto" else args.backend,
            ollama_model=args.ollama_model,
            ollama_url=args.ollama_url,
        )
        backend = resolve_backend(args.backend, backends)

        pages: list[dict] = []
        for path in inputs:
            file_pages = recognize_file(path, backend, args)
            if not file_pages:
                # 后端返回空也属识别失败，不产出「成功但空输出」的假成功。
                raise fail(EXIT_OCR_FAILED, f"识别失败: {path}（未产出任何文本页）")
            # source 在入口统一回填（而非各识别函数自己拼）：多文件输入时下游靠它
            # 把页归回文件；单文件也带，保证 json 形状恒定。
            for page in file_pages:
                page["source"] = path.name
            pages.extend(file_pages)

        sys.stdout.write(serialize_pages(pages, args.format, backend.get("name")))
        sys.stdout.write("\n")
        return EXIT_OK
    except EimgError as exc:
        warn(exc.message)
        return exc.code
    except KeyboardInterrupt:
        warn("已中断")
        return 130
    except subprocess.SubprocessError as exc:  # 探测阶段的子进程异常
        warn(f"识别失败: 子进程异常（{exc}）")
        return EXIT_OCR_FAILED


if __name__ == "__main__":
    sys.exit(main())
